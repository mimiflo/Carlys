# Exemple de configuration Nginx pour Carlys (staging/production).
# À adapter : noms de domaine, chemins des certificats, upstreams.
#
# Ce fichier se charge tel quel (`nginx -t`) dès que les certificats existent
# aux chemins indiqués, par exemple avec certbot :
#   certbot certonly --webroot -w /var/www/certbot \
#     -d api.carlys.example -d admin.carlys.example
#
# Côté API, régler TRUST_PROXY_HOPS=1 : l'API fait alors confiance à CE proxy,
# et à lui seul, pour lire l'adresse du client dans X-Forwarded-For (rate
# limiting, verrouillage, audit). Voir docs/security/reverse-proxy.md.

upstream carlys_api {
    server 127.0.0.1:3000;
}

upstream carlys_admin {
    server 127.0.0.1:3001;
}

# ── HTTP : rien n'est servi en clair, tout est redirigé vers HTTPS ───────────
server {
    listen 80;
    listen [::]:80;
    server_name api.carlys.example admin.carlys.example;

    # Renouvellement des certificats (certbot en mode webroot).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── API ──────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.carlys.example;

    ssl_certificate     /etc/letsencrypt/live/api.carlys.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.carlys.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # HSTS posé ICI : helmet ne le pose que sur les réponses qui atteignent
    # l'API, jamais sur une requête en clair interceptée en amont.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Corps JSON : même plafond que l'API (MAX_JSON_BODY_SIZE = '1mb' dans
    # packages/shared-config). Les deux valeurs bougent ensemble : au-delà,
    # c'est Nginx qui répond 413, sans l'enveloppe d'erreur de l'API.
    client_max_body_size 1m;

    # Adresse et protocole d'origine, transmis à l'API. Avec
    # TRUST_PROXY_HOPS=1, l'API retient la DERNIÈRE adresse de
    # X-Forwarded-For, celle que Nginx ajoute lui-même ($remote_addr) : une
    # valeur forgée par le client est reléguée plus tôt dans la liste et
    # ignorée.
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  $server_port;

    location /health {
        proxy_pass http://carlys_api;
        access_log off;
    }

    # Dépôt de médias (multipart) : plafond de TRANSPORT de l'API,
    # MEDIA_TRANSPORT_HARD_CAP_BYTES = 64 Mio (packages/api-contracts/src/media.ts,
    # appliqué par le FileInterceptor de media.controller.ts). Le plafond
    # MÉTIER, MEDIA_MAX_UPLOAD_BYTES (20 Mio par défaut, réglable par
    # environnement), est appliqué par l'API elle-même avec l'enveloppe
    # { error: { code, message, … } } : Nginx ne doit jamais couper avant elle,
    # sinon l'admin reçoit un 413 illisible. Si MEDIA_TRANSPORT_HARD_CAP_BYTES
    # change, cette valeur change avec lui.
    location /api/v1/admin/media {
        client_max_body_size 64m;
        proxy_pass http://carlys_api;
    }

    location /api/ {
        proxy_pass http://carlys_api;
    }

    # /metrics n'est jamais exposé publiquement : le collecteur Prometheus
    # interroge l'API directement, sur le réseau privé.
    location /metrics {
        deny all;
    }

    # Tout le reste : l'API ne sert rien d'autre.
    location / {
        return 404;
    }
}

# ── Admin ────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name admin.carlys.example;

    ssl_certificate     /etc/letsencrypt/live/admin.carlys.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.carlys.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Cet hôte sert AUSSI les pages publiques du produit (/verify-email,
    # /reset-password, /abonnement, /privacy, /terms) : PUBLIC_APP_URL et
    # CORS_ORIGINS de l'API doivent le désigner (https://admin.carlys.example).
    # Un hôte dédié (app.carlys.example) peut proxier le même upstream.

    location / {
        proxy_pass http://carlys_admin;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
