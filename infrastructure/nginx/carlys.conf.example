# Exemple de configuration Nginx pour Carlys (staging/production).
# À adapter : noms de domaine, certificats, upstreams.

upstream carlys_api {
    server 127.0.0.1:3000;
}

upstream carlys_admin {
    server 127.0.0.1:3001;
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.carlys.example;

    # ssl_certificate     /etc/letsencrypt/live/carlys.example/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/carlys.example/privkey.pem;

    client_max_body_size 2m;

    location /health {
        proxy_pass http://carlys_api;
        access_log off;
    }

    location /api/ {
        proxy_pass http://carlys_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # /metrics n'est jamais exposé publiquement.
    location /metrics {
        deny all;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name admin.carlys.example;

    # Cet hôte sert AUSSI les pages publiques du produit (/verify-email,
    # /reset-password, /abonnement, /privacy, /terms) : PUBLIC_APP_URL et
    # CORS_ORIGINS de l'API doivent le désigner (https://admin.carlys.example).
    # Un hôte dédié (app.carlys.example) peut proxier le même upstream.
    location / {
        proxy_pass http://carlys_admin;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
