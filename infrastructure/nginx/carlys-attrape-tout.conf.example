# Carlys — vhost ATTRAPE-TOUT : ce que reçoit un nom d'hôte qu'on ne sert pas.
#
# ── Pourquoi ce fichier existe ───────────────────────────────────────────────
#
# Le guide de mise en route fait retirer /etc/nginx/sites-enabled/default. À
# partir de là, plus AUCUN bloc ne porte `default_server` : Nginx désigne alors
# d'office le PREMIER bloc rencontré pour chaque port. `sites-enabled/*` est
# inclus par ordre alphabétique, donc `carlys-production.conf` passe avant
# `carlys-staging.conf`, et le premier bloc 443 du fichier de production est
# celui de l'API. Conséquence : une requête sur le domaine nu, sur `www`, sur
# un sous-domaine oublié ou sur l'IP brute atteint l'API DE PRODUCTION, avec
# un certificat au mauvais nom. Ce n'est ni ce que le guide décrit ni ce qu'on
# veut : ce fichier reprend la place de défaut et ferme la porte.
#
# Il est INDÉPENDANT des deux autres et peut être activé seul, y compris sur un
# serveur qui n'héberge encore que la recette : il ne référence aucun
# certificat Let's Encrypt.
#
# ── Le certificat auto-signé n'est pas un pis-aller, c'est le sujet ──────────
#
# Un bloc `listen 443 ssl` exige un certificat, et il n'en existe évidemment
# aucun de valide pour un nom qu'on ne sert pas. Le client DOIT donc voir une
# erreur de certificat : c'est la réponse correcte à « donne-moi un site que tu
# n'héberges pas ». Le certificat ci-dessous ne sert qu'à ouvrir la
# poignée de main pour la refuser ensuite.
#
# (`ssl_reject_handshake on;`, qui dirait la même chose sans certificat, n'est
# apparu qu'en Nginx 1.25.5 — hors de portée du Nginx de Debian 12 et d'Ubuntu
# 22.04 que ce dépôt installe. Voir la note HTTP/2 de
# carlys-production.conf.example : même arbitrage, même raison.)
#
# ── Installation ─────────────────────────────────────────────────────────────
#
#   sudo mkdir -p /etc/nginx/ssl
#   sudo openssl req -x509 -nodes -newkey rsa:2048 -days 3650 \
#     -subj '/CN=hote-inconnu' \
#     -keyout /etc/nginx/ssl/attrape-tout.key \
#     -out    /etc/nginx/ssl/attrape-tout.crt
#   sudo chmod 600 /etc/nginx/ssl/attrape-tout.key
#   sudo cp infrastructure/nginx/carlys-attrape-tout.conf.example \
#           /etc/nginx/sites-available/carlys-attrape-tout.conf
#   sudo ln -sf /etc/nginx/sites-available/carlys-attrape-tout.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Aucun domaine à substituer ici : ce fichier ne nomme aucun hôte, c'est sa
# raison d'être.

server {
    listen 80  default_server;
    listen [::]:80  default_server;
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;

    # `_` n'est pas un joker : c'est un nom qui ne peut correspondre à aucun
    # en-tête Host. Ce qui amène ici, c'est `default_server`, pas ce nom.
    server_name _;

    ssl_certificate     /etc/nginx/ssl/attrape-tout.crt;
    ssl_certificate_key /etc/nginx/ssl/attrape-tout.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Le renouvellement certbot passe par les six vhosts nommés, qui servent
    # eux-mêmes /.well-known/acme-challenge/. Mais tant qu'un nom N'A PAS
    # encore son vhost — le jour où l'on ajoute un sous-domaine —, c'est ici
    # que son défi ACME atterrit. Le servir coûte trois lignes et évite une
    # émission impossible à diagnostiquer.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 444 : Nginx ferme la connexion sans rien renvoyer. Pas de page d'erreur,
    # pas de numéro de version, aucune indication qu'il y a quelque chose à
    # cette adresse.
    location / {
        return 444;
    }
}
