# Carlys — SECRETS de la RECETTE (staging). MODÈLE, jamais de vraie valeur ici.
#
# Le vrai fichier vit sur le serveur, hors du dépôt :
#
#   /srv/carlys/staging/.env     (chmod 600, propriétaire root)
#
# Il ne porte QUE des secrets (ADR 0017) : mots de passe, clés, jetons, et
# les adresses qui en contiennent un. Tous les RÉGLAGES (domaine, ports,
# mémoire, coach, e-mail…) sont versionnés dans
# infrastructure/server/config/commun.conf et staging.conf : on les change
# par un commit, pas ici. Un réglage remis ici l'emporterait sur eux (ce
# fichier se lit en dernier) : `carlysctl doctor` le signale.
#
# Mise en service :
#   1. cp staging.env.example /srv/carlys/staging/.env && chmod 600 …
#   2. remplacer chaque CHANGE_MOI_… par une vraie valeur ; les jetons marqués
#      `#carlysctl:engendrer` se fabriquent seuls :
#        carlysctl env-sync staging --appliquer --tout
#   3. vérifier qu'il n'en reste aucun :
#        grep -n '^[^#]*CHANGE_MOI_' /srv/carlys/staging/.env
#
# TROIS RÈGLES QUI COÛTENT CHER SI ON LES OUBLIE :
#
#   • Une variable FACULTATIVE se laisse COMMENTÉE, jamais vide. `CLE=` arrive
#     dans le conteneur comme chaîne VIDE, que le schéma Zod rejette
#     (`.min(20)` sur une chaîne de longueur 0) : l'API refuserait de démarrer.
#
#   • Les valeurs entre ${…} sont résolues par docker compose À LA LECTURE, à
#     partir de ce qui est déjà chargé : la configuration versionnée (lue
#     AVANT ce fichier) et les lignes PLUS HAUT ici. Ne déplacez pas un bloc
#     au-dessus de ce dont il dépend.
#
#   • Un `$` dans une VALEUR ouvre une substitution, il ne reste pas :
#     `MDP=mot$de$passe` arrive comme `mot`, et si le nom qui suit le `$`
#     existe côté hôte, la substitution RÉUSSIT sans un mot. Il faut DOUBLER
#     chaque `$` en `$$`. Les recettes de ce fichier (`openssl rand -base64`,
#     `openssl rand -hex`) n'en produisent jamais ; un mot de passe fourni par
#     un tiers, une empreinte bcrypt/argon2 et surtout
#     FIREBASE_SERVICE_ACCOUNT_JSON, si.

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# openssl rand -base64 32 | tr -d '/+=' — évitez @ : / dans un mot de passe
# qui finit dans une URL de connexion.
POSTGRES_PASSWORD=CHANGE_MOI_MOT_DE_PASSE_POSTGRES

# L'URL de connexion de l'API, qui CONTIENT le mot de passe : elle vit donc
# ici, après lui (Compose ne résout ${…} que vers ce qui est déjà lu).
# POSTGRES_USER et POSTGRES_DB viennent de la configuration versionnée.
# `connection_limit` N'EST PAS FACULTATIF, et le chiffre se calcule : Prisma
# ouvre par défaut (2 × cœurs + 1) connexions PAR PROCESSUS — 17 sur 8
# cœurs ; à un exemplaire par cœur, 136 connexions pour un PostgreSQL livré à
# max_connections = 100. La borne : (100 - ~20 de marge pour migrations,
# sauvegarde et administration) / 8 exemplaires au plafond = 10 par
# processus. `pool_timeout=20` laisse une rafale faire la queue plutôt
# qu'échouer à 10 s.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?connection_limit=10&pool_timeout=20

# ── MinIO ──────────────────────────────────────────────────────────────────
# NE DOIVENT PAS commencer par « carlys-dev » : env.production.ts refuse les
# identifiants de développement, et l'API ne démarrerait pas.
MINIO_ROOT_USER=CHANGE_MOI_MINIO_ACCESS_KEY
# Au moins 8 caractères (exigence de MinIO). openssl rand -base64 32
MINIO_ROOT_PASSWORD=CHANGE_MOI_MOT_DE_PASSE_MINIO
# Les identifiants S3 de l'API : ceux du conteneur MinIO, écrits une fois.
S3_ACCESS_KEY_ID=${MINIO_ROOT_USER}
S3_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}

# ── Jetons de l'API ────────────────────────────────────────────────────────
# OBLIGATOIRE, en recette AUSSI. Le garde de /metrics regarde NODE_ENV, qui
# vaut « production » ici aussi : sans jeton, /metrics répond 404, et
# `carlysctl` n'y lit ni le débit, ni la latence, ni les utilisateurs en
# ligne — la mise à l'échelle reste figée, faute de mesure.
#   openssl rand -hex 32
#carlysctl:engendrer hex32
METRICS_TOKEN=CHANGE_MOI_JETON_METRIQUES

# 32 caractères minimum. openssl rand -hex 32
# DIFFÉRENT de celui de production : un jeton de recette ne doit jamais ouvrir
# la production.
#carlysctl:engendrer hex32
JWT_ACCESS_SECRET=CHANGE_MOI_SECRET_JWT_STAGING_OPENSSL_RAND_HEX_32

# Clé des empreintes de journal (adresses e-mail, identifiants de connexion
# pseudonymisés dans les journaux et l'audit). Propre à cet usage : faire
# tourner JWT_ACCESS_SECRET ne casse pas le rapprochement des empreintes.
# Absente, l'API dérive l'empreinte du secret JWT ; la poser change les
# empreintes UNE fois. 32 caractères minimum. La supervision l'engendre
# d'elle-même si elle manque ; l'API la prend à son prochain redémarrage.
#carlysctl:engendrer-auto hex32
LOG_FINGERPRINT_SECRET=CHANGE_MOI_CLE_EMPREINTES_STAGING_OPENSSL_RAND_HEX_32

# ── E-mails ────────────────────────────────────────────────────────────────
# VIDES en recette : Mailpit n'authentifie rien, et un identifiant vide fait
# sauter le bloc `auth` au lieu de tenter une authentification refusée.
SMTP_USER=
SMTP_PASSWORD=

# ── Abonnements — FACULTATIFS ──────────────────────────────────────────────
# Tant qu'un secret de webhook manque, l'endpoint correspondant répond 503 :
# aucun webhook non signé n'est jamais traité.
#   Stripe     : tableau de bord → Développeurs → Webhooks → clé de signature
#                (whsec_…), point de terminaison https://api-staging.${DOMAIN}/api/v1/…
#   RevenueCat : tableau de bord → Integrations → Webhooks → Authorization
# STRIPE_WEBHOOK_SECRET=
# REVENUECAT_WEBHOOK_SECRET=
#
# La clé secrète Stripe (sk_test_… en recette) : sans elle, le catalogue
# reste lisible et l'achat se déclare indisponible. Elle sert aussi à
# RÉSILIER l'abonnement d'un compte qu'on supprime (une clé restreinte doit
# avoir l'écriture sur les abonnements). Le déploiement (étape 6/8) refuse de
# basculer si elle est posée sans STRIPE_WEBHOOK_SECRET ni les tarifs
# (STRIPE_PRICE_*, dans staging.conf).
# STRIPE_SECRET_KEY=

# ── Notifications push — FACULTATIF ────────────────────────────────────────
# JSON du compte de service, sur UNE seule ligne, chaque `$` doublé (console
# Firebase → Paramètres du projet → Comptes de service → Générer une clé).
# Sans lui, l'ENVOI est désactivé ; l'enregistrement des jetons d'appareil
# continue.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Coach IA — FACULTATIF ──────────────────────────────────────────────────
# Seulement pour un worker HORS du réseau compose (https:// exigé). Ollama
# sur le serveur n'en demande aucune.
# COACH_API_KEY=
