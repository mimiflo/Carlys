# Carlys — environnement STAGING (recette). MODÈLE, jamais de vraie valeur ici.
#
# Ce fichier est versionné : il ne contient QUE des valeurs factices. Le vrai
# fichier vit sur le serveur, hors du dépôt :
#
#   /srv/carlys/staging/.env     (chmod 600, propriétaire root)
#
# Mise en service :
#   1. cp staging.env.example /srv/carlys/staging/.env && chmod 600 …
#   2. y remplacer la valeur de DOMAIN (juste en dessous) par le domaine réel.
#      Tous les sous-domaines en dérivent : c'est le SEUL endroit à corriger.
#   3. remplacer chaque autre CHANGE_MOI_… par une vraie valeur (voir plus bas).
#   4. vérifier qu'il n'en reste aucun :
#        grep -n '^[^#]*CHANGE_MOI_' /srv/carlys/staging/.env
#
# QUATRE RÈGLES QUI COÛTENT CHER SI ON LES OUBLIE :
#
#   • NODE_ENV=production ICI AUSSI. C'est le mode d'exécution de Nest, pas le
#     nom de l'environnement. Il ARME au passage les refus de
#     apps/api/src/config/env.production.ts : une valeur de développement
#     restée en place (localhost, identifiant carlys-dev*, URL en clair) fait
#     REFUSER le démarrage. C'est voulu — la recette doit échouer comme la
#     production, sinon elle ne prouve rien.
#
#   • Une variable FACULTATIVE se laisse COMMENTÉE, jamais vide. `CLE=` arrive
#     dans le conteneur comme chaîne VIDE, que le schéma Zod rejette
#     (`.min(20)` sur une chaîne de longueur 0) : l'API refuserait de démarrer.
#     Commentée, elle est simplement absente — ce que `.optional()` accepte.
#
#   • Les valeurs entre ${…} sont résolues par docker compose À LA LECTURE de
#     ce fichier, depuis les variables déclarées PLUS HAUT dans ce même
#     fichier. C'est ce qui évite d'écrire le mot de passe PostgreSQL à deux
#     endroits. Ne déplacez pas un bloc au-dessus de ce dont il dépend.
#
#   • Corollaire du point précédent, et c'est celui qui fait perdre une
#     soirée : un `$` dans une VALEUR ouvre une substitution, il ne reste pas.
#     `MDP=mot$de$passe` arrive dans le conteneur comme `mot` — compose
#     prévient sur la sortie d'erreur, au milieu du bruit d'un déploiement.
#     Pire, si le nom qui suit le `$` existe côté hôte, la substitution
#     RÉUSSIT sans un mot : `mot$HOME/x` devient `mot/root/x`. Il faut DOUBLER
#     chaque `$` en `$$`. Les recettes de ce fichier (`openssl rand -base64`,
#     `openssl rand -hex`) n'en produisent jamais ; un mot de passe fourni par
#     un tiers, une empreinte bcrypt/argon2 (`$2b$…`, `$argon2id$…`) et surtout
#     FIREBASE_SERVICE_ACCOUNT_JSON, si.
#
# Toutes les variables de la section API sont celles de
# apps/api/src/config/env.schema.ts — aucune de plus, aucune de moins.

# ═══════════════════════════════════════════════════════════════════════════
#  1. Pile compose (lu par docker compose, pas par l'API)
# ═══════════════════════════════════════════════════════════════════════════

# ── Domaine ────────────────────────────────────────────────────────────────
# La SEULE valeur à changer pour déplacer toute la pile sur un autre domaine :
# CORS_ORIGINS, S3_PUBLIC_BASE_URL, EMAIL_FROM et PUBLIC_APP_URL en dérivent
# plus bas. Les sous-domaines, eux, sont fixés par le contrat de conception
# (api-staging. / app-staging. / media-staging. en recette, api. / app. /
# media. en production) — ils ne se paramètrent pas. C'est LE MÊME domaine
# qu'en production : seuls les sous-domaines changent.
#
# scripts/server/setup.sh relit CETTE ligne pour afficher les enregistrements
# DNS à poser : la laisser sur sa valeur factice lui fait annoncer
# « api-staging.CHANGE_MOI_exemple.fr », ce qui est le bon aveu — plutôt qu'un
# « exemple.fr » d'apparence configurée.
DOMAIN=CHANGE_MOI_exemple.fr

# Isole conteneurs, réseau et volumes de ceux de production sur le même hôte.
COMPOSE_PROJECT_NAME=carlys_staging
# Active le profil qui démarre Mailpit. La production ne le pose pas : un même
# `docker compose up -d` sert donc les deux environnements, sans drapeau.
COMPOSE_PROFILES=staging

CARLYS_ENV=staging
# Chemin ABSOLU de CE fichier sur le serveur : compose s'en sert pour le
# passer au conteneur de l'API depuis n'importe quel répertoire courant.
CARLYS_ENV_FILE=/srv/carlys/staging/.env

# ── Images ─────────────────────────────────────────────────────────────────
CARLYS_REGISTRY=ghcr.io/mimiflo
# RÉÉCRIT PAR deploy.sh à chaque bascule réussie, et après un retour arrière :
# la valeur ici décrit toujours ce qui tourne réellement. C'est ce qui rend
# utilisable la commande écrite en tête de compose.yml —
#   docker compose --env-file <ce fichier> -f compose.yml up -d
# — notamment pour relever la pile après un `docker compose stop` volontaire.
# Laissée à sa valeur d'exemple, cette commande échouerait sur une image
# inexistante alors que rien n'est cassé.
#
# Pendant son exécution, deploy.sh exporte en plus CARLYS_TAG dans son propre
# shell : compose donne la priorité à l'environnement sur le fichier, donc la
# bascule est déjà juste avant même que cette ligne ne soit réécrite.
CARLYS_TAG=sha-CHANGE_MOI_SHA12
# Vide en recette : l'image admin de staging est celle dont la garde légale
# est desserrée. La production, elle, réclame le suffixe -prod.
CARLYS_ADMIN_TAG_SUFFIX=

# ── Ports publiés, sur la boucle locale UNIQUEMENT ─────────────────────────
CARLYS_API_HOST_PORT=3100
CARLYS_ADMIN_HOST_PORT=3101
CARLYS_MINIO_HOST_PORT=9200
CARLYS_MAILPIT_UI_HOST_PORT=8025

# ── PostgreSQL (identifiants du conteneur) ─────────────────────────────────
POSTGRES_USER=carlys
# openssl rand -base64 32 | tr -d '/+=' — évitez @ : / dans un mot de passe
# qui finit dans une URL de connexion.
POSTGRES_PASSWORD=CHANGE_MOI_MOT_DE_PASSE_POSTGRES
POSTGRES_DB=carlys_staging

# ── Redis ──────────────────────────────────────────────────────────────────
# Recette : cache jetable, aucune persistance sur disque.
CARLYS_REDIS_ARGS=--save "" --appendonly no

# ── MinIO (identifiants du conteneur) ──────────────────────────────────────
# NE DOIVENT PAS commencer par « carlys-dev » : env.production.ts refuse les
# identifiants de développement, et l'API ne démarrerait pas.
MINIO_ROOT_USER=CHANGE_MOI_MINIO_ACCESS_KEY
# Au moins 8 caractères (exigence de MinIO). openssl rand -base64 32
MINIO_ROOT_PASSWORD=CHANGE_MOI_MOT_DE_PASSE_MINIO

# ═══════════════════════════════════════════════════════════════════════════
#  2. API — apps/api/src/config/env.schema.ts
# ═══════════════════════════════════════════════════════════════════════════

# ── Exécution ──────────────────────────────────────────────────────────────
NODE_ENV=production
# Port INTERNE au conteneur. Le port de l'hôte est CARLYS_API_HOST_PORT.
PORT=3000

# Noms d'hôtes du réseau compose : « postgres », « redis » et « minio » ne se
# résolvent QUE là. Le mot de passe n'est écrit qu'une fois, plus haut.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
REDIS_URL=redis://redis:6379

# Origine du navigateur qui appelle l'API : l'application web, jamais l'API.
CORS_ORIGINS=https://app-staging.${DOMAIN}
LOG_LEVEL=debug

# UN SEUL nginx devant l'API. Ni 0 (l'API ne verrait que l'adresse du proxy —
# limitation de débit, verrouillage et audit deviendraient aveugles), ni plus
# (un client forgerait son adresse). Voir docs/security/reverse-proxy.md.
TRUST_PROXY_HOPS=1

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Vrai en recette : /api/docs est l'outil de la recette. Faux en production.
SWAGGER_ENABLED=true

# FACULTATIVE — sans elle, /metrics répond comme s'il n'existait pas, ce qui
# est le bon état par défaut. Pour l'ouvrir : openssl rand -hex 32
# METRICS_TOKEN=

# ── Authentification ───────────────────────────────────────────────────────
# 32 caractères minimum. openssl rand -hex 32
# DIFFÉRENT de celui de production : un jeton de recette ne doit jamais ouvrir
# la production.
JWT_ACCESS_SECRET=CHANGE_MOI_SECRET_JWT_STAGING_OPENSSL_RAND_HEX_32
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=carlys-api
JWT_AUDIENCE=carlys-mobile
REFRESH_TOKEN_TTL_DAYS=30

AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# ── Abonnements ────────────────────────────────────────────────────────────
# FACULTATIVES. Tant qu'un secret de webhook manque, l'endpoint correspondant
# répond 503 : aucun webhook non signé n'est jamais traité.
#   Stripe     : tableau de bord → Développeurs → Webhooks → clé de signature
#                (whsec_…), point de terminaison https://api-staging.${DOMAIN}/api/v1/…
#   RevenueCat : tableau de bord → Integrations → Webhooks → Authorization
# STRIPE_WEBHOOK_SECRET=
# REVENUECAT_WEBHOOK_SECRET=

# Affichage seul : c'est Stripe qui encaisse. Ces prix doivent refléter ceux
# du catalogue Stripe correspondant.
SUBSCRIPTION_CURRENCY=EUR
SUBSCRIPTION_MONTHLY_CENTS=999
SUBSCRIPTION_YEARLY_CENTS=7990
SUBSCRIPTION_TRIAL_DAYS=7

# FACULTATIVES. Sans elles le catalogue reste lisible et l'achat se déclare
# indisponible — on ne promet pas un paiement qui échouerait.
#   Clé secrète : Stripe → Développeurs → Clés d'API (sk_test_… en recette)
#   Identifiants de tarif : Stripe → Produits → Tarification (price_…)
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_YEARLY=

# ── Notifications push ─────────────────────────────────────────────────────
# FACULTATIVE — JSON du compte de service, sur UNE seule ligne (console
# Firebase → Paramètres du projet → Comptes de service → Générer une clé).
# Sans elle, l'ENVOI est désactivé ; l'enregistrement des jetons d'appareil
# continue de fonctionner, et les envois reprennent sans redéploiement mobile.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Coach IA ───────────────────────────────────────────────────────────────
# FACULTATIVE — sans elle le module se déclare indisponible (503) au lieu
# d'empêcher le démarrage. console.anthropic.com → API keys.
# ANTHROPIC_API_KEY=
COACH_MODEL=claude-opus-5
COACH_DAILY_MESSAGE_LIMIT=30
COACH_ENABLED=true

# ── Stockage objet ─────────────────────────────────────────────────────────
# Adresse INTERNE : l'API dépose les fichiers par le réseau compose.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=carlys-media
# Mêmes identifiants que le conteneur MinIO, écrits une seule fois plus haut.
S3_ACCESS_KEY_ID=${MINIO_ROOT_USER}
S3_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
# Adresse PUBLIQUE : celle que le téléphone et le navigateur téléchargent.
# nginx sert ce sous-domaine devant MinIO. Doit être en https:// et ne jamais
# pointer vers localhost — env.production.ts refuse les deux.
S3_PUBLIC_BASE_URL=https://media-staging.${DOMAIN}/carlys-media
S3_FORCE_PATH_STYLE=true
MEDIA_MAX_UPLOAD_BYTES=20971520

# ── E-mails ────────────────────────────────────────────────────────────────
# Recette : Mailpit, sur le réseau compose. Rien ne part vers de vraies boîtes,
# et l'interface se lit sur 127.0.0.1:8025 (tunnel SSH).
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=Carlys (recette) <no-reply@staging.${DOMAIN}>

# Base des liens envoyés par e-mail et des retours Stripe : l'APPLICATION WEB,
# jamais l'API — c'est elle qui sert /verify-email, /reset-password, /privacy,
# /terms et /abonnement (infrastructure/deployment/README.md).
PUBLIC_APP_URL=https://app-staging.${DOMAIN}
