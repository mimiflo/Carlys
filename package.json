{
  "name": "carlys",
  "version": "0.1.0",
  "private": true,
  "description": "Carlys — plateforme fitness multiplateforme (Flutter, NestJS, Next.js)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @carlys/api --filter @carlys/admin dev",
    "dev:api": "pnpm --filter @carlys/api dev",
    "dev:admin": "pnpm --filter @carlys/admin dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "pnpm --filter @carlys/api prisma:generate",
    "prisma:migrate": "pnpm --filter @carlys/api prisma:migrate",
    "prisma:seed": "pnpm --filter @carlys/api prisma:seed",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "refresh": "bash scripts/after_update.sh"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts@<8.0.0": "8.0.1",
      "fast-uri@<3.1.6": "3.1.6",
      "js-yaml@5": "5.2.3",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "multer@<2.3.0": "2.3.0",
      "nanoid@<3.3.18": "3.3.18",
      "qs@<6.16.0": "6.16.0",
      "uuid@<11.1.1": "11.1.1"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "argon2",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
