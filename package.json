{
  "name": "carlys",
  "version": "0.1.0",
  "private": true,
  "description": "Carlys — plateforme fitness multiplateforme (Flutter, NestJS, Next.js)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @carlys/api --filter @carlys/admin dev",
    "dev:api": "pnpm --filter @carlys/api dev",
    "dev:admin": "pnpm --filter @carlys/admin dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "pnpm --filter @carlys/api prisma:generate",
    "prisma:migrate": "pnpm --filter @carlys/api prisma:migrate",
    "prisma:seed": "pnpm --filter @carlys/api prisma:seed",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@5": "5.2.3"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "argon2",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
