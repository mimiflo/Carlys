{
  "name": "@carlys/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens Carlys — source de vérité des couleurs, espacements, rayons, typographie, ombres, mouvements et breakpoints",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.json": "./src/tokens.json"
  },
  "files": [
    "dist",
    "src/tokens.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@carlys/eslint-config": "workspace:*",
    "@carlys/typescript-config": "workspace:*",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3"
  }
}
