// Schéma Prisma de Carlys.
//
// Introduit par tranches verticales :
//   - Étape 2 : identité et authentification.
//   - Étape 3 (actuelle) : catalogue d'exercices.
//   - Étape 4 : séances (WorkoutSession, WorkoutSet, …)
// Le modèle de données cible complet est documenté dans docs/database/schema.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Identité ────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  /// Normalisé en minuscules par la couche application avant écriture.
  email           String     @unique
  /// Code ami : identité PARTAGEABLE (8 caractères, alphabet sans
  /// ambiguïté visuelle — voir modules/users/domain/friend-code.ts).
  /// Affiché en XXXX-XXXX, porté par le QR de profil, unique à vie.
  friendCode      String     @unique
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  /// Suppression logique : le compte est désactivé, purge différée.
  deletedAt       DateTime?

  profile            UserProfile?
  credential         UserCredential?
  sessions           UserSession[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  externalIdentities ExternalIdentity[]
  auditLogs          AuditLog[]
  workoutTemplates   WorkoutTemplate[]
  programs           Program[]
  workoutSessions    WorkoutSession[]
  personalRecords    PersonalRecord[]
  progressMilestones ProgressMilestone[]
  bodyMetrics        BodyMetric[]
  subscriptions      Subscription[]
  entitlements       UserEntitlement[]
  coachConversations CoachConversation[]
  equipment          UserEquipment[]

  mealEntries              MealEntry[]
  quizAnswers              QuizAnswer[]
  communityPreference      CommunityPreference?
  friendshipsSent          Friendship[]             @relation("FriendshipsSent")
  friendshipsReceived      Friendship[]             @relation("FriendshipsReceived")
  encouragementsSent       Encouragement[]          @relation("EncouragementsSent")
  encouragementsReceived   Encouragement[]          @relation("EncouragementsReceived")
  challengeParticipations  ChallengeParticipation[]
  friendChallengesCreated  FriendChallenge[]
  friendChallengeMembers   FriendChallengeMember[]
  leagueMemberships        LeagueMembership[]
  communityBlocksIssued    CommunityBlock[]         @relation("CommunityBlocksIssued")
  communityBlocksReceived  CommunityBlock[]         @relation("CommunityBlocksReceived")
  communityReportsFiled    CommunityReport[]        @relation("CommunityReportsFiled")
  communityReportsReceived CommunityReport[]        @relation("CommunityReportsReceived")
  deviceTokens             DeviceToken[]
  notificationPreferences  NotificationPreference[]
}

/// Sexe biologique — nécessaire aux formules métaboliques (Mifflin-St Jeor).
enum BiologicalSex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum NutritionGoal {
  LOSE_WEIGHT
  MAINTAIN
  GAIN_MUSCLE
}

/// Objectif d'ENTRAÎNEMENT — un axe distinct de l'objectif nutritionnel
/// (deux questions, deux réponses : viser un marathon en recomposition
/// corporelle est parfaitement cohérent). Extensible : une valeur inconnue
/// côté client rend `null`, jamais un objectif deviné.
enum TrainingGoal {
  FAT_LOSS
  MUSCLE_GAIN
  RECOMPOSITION
  HYROX
  MARATHON
  MAINTENANCE
  STRENGTH
  CALISTHENICS
}

/// Expérience d'entraînement — entrée de génération (Plan 4) : elle règle
/// le volume et la complexité du programme, jamais l'identité (le profil
/// Carlys n'est PAS un niveau, celle-ci en est un, assumé).
enum TrainingExperience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model UserProfile {
  userId      String   @id @db.Uuid
  displayName String
  locale      String   @default("fr")
  timezone    String   @default("Europe/Paris")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── Profil métabolique (Étape nutrition) — tous facultatifs, le rapport
  // liste les champs manquants ; le poids vient des mesures corporelles.
  sex           BiologicalSex?
  birthDate     DateTime?
  heightCm      Decimal?       @db.Decimal(4, 1)
  activityLevel ActivityLevel?
  nutritionGoal NutritionGoal?

  /// Profil Carlys choisi — une IDENTITÉ d'usage, jamais un niveau.
  /// Nullable tant que la personne n'a pas choisi ; modifiable à tout moment.
  carlysProfile CarlysProfile?

  /// Style de voix du Mentor Carlys — un axe INDÉPENDANT du profil : le
  /// profil décrit l'utilisateur, le style décrit la VOIX qui lui parle.
  /// Nullable tant que la personne n'a pas choisi.
  mentorStyle MentorStyle?

  /// Objectif d'ENTRAÎNEMENT (Plan 4) — coexiste avec `nutritionGoal`,
  /// jamais déduit de lui. Nullable tant que la personne n'a pas choisi ;
  /// la génération de programme s'en servira comme entrée première.
  trainingGoal TrainingGoal?

  // ── Entrées de génération de programme (Plan 4) — tous facultatifs :
  // la génération liste ce qui manque, elle n'invente rien.
  trainingExperience TrainingExperience?
  /// Séances visées par semaine (bornes du contrat : 1 à 7).
  weeklySessionsTarget Int?
  /// Durée visée d'une séance, en minutes (bornes du contrat : 15 à 240).
  sessionMinutesTarget Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Les 4 profils Carlys. Ce ne sont PAS des niveaux : un débutant peut être
/// Stratège, un sportif avancé Challenger — et l'on évolue de l'un à l'autre.
enum CarlysProfile {
  CONSTRUCTEUR
  CHALLENGER
  ATHLETE
  STRATEGE
}

/// Les 4 styles de voix du Mentor Carlys. Les deux axes se COMPOSENT
/// (4 briefings de profil + 4 de style, jamais 16 combinaisons écrites).
enum MentorStyle {
  BIENVEILLANT
  EXIGEANT
  ATHLETE
  PHILOSOPHE
}

model UserCredential {
  userId       String   @id @db.Uuid
  /// Hash Argon2id — jamais le mot de passe, jamais loggé, jamais retourné.
  passwordHash String
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Connexion via fournisseur externe (Apple, Google) — endpoints à venir,
/// le modèle fixe dès maintenant la contrainte d'unicité.
enum ExternalIdentityProvider {
  APPLE
  GOOGLE
}

model ExternalIdentity {
  id        String                   @id @default(uuid()) @db.Uuid
  userId    String                   @db.Uuid
  provider  ExternalIdentityProvider
  /// Identifiant stable du compte chez le fournisseur (claim `sub`).
  subject   String
  email     String?
  createdAt DateTime                 @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

// ─────────────────────────── Sessions & tokens ───────────────────────────

/// Session par appareil. L'access token JWT référence la session (claim sid) ;
/// la révoquer invalide immédiatement les requêtes authentifiées.
model UserSession {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  deviceName     String?
  devicePlatform String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())
  /// Expiration glissante : repoussée à chaque rotation du refresh token.
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

enum RefreshTokenStatus {
  ACTIVE
  ROTATED
  REVOKED
}

/// Jeton opaque à usage unique (hash SHA-256 en base). Présenter un jeton
/// ROTATED ou REVOKED = réutilisation détectée → révocation de la session.
model RefreshToken {
  id        String             @id @default(uuid()) @db.Uuid
  sessionId String             @db.Uuid
  tokenHash String             @unique
  status    RefreshTokenStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  expiresAt DateTime
  rotatedAt DateTime?

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// ─────────────────────── Vérifications par e-mail ────────────────────────

model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ────────────────────────────── Audit ────────────────────────────────────

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

/// Journal APPEND-ONLY des événements de sécurité et des actions sensibles.
/// Alimenté dès l'Étape 2 ; enrichi et consulté par l'admin à l'Étape 7.
/// Volontairement sans clé étrangère vers les ressources auditées : le
/// journal survit à leur suppression (référence logique resourceType/Id).
model AuditLog {
  id           String         @id @default(uuid()) @db.Uuid
  actorType    AuditActorType @default(USER)
  userId       String?        @db.Uuid
  adminUserId  String?        @db.Uuid
  /// Ex. auth.login, auth.refresh_reuse_detected, admin.user_suspended…
  action       String
  resourceType String?
  resourceId   String?
  /// Corrélation avec les logs Pino et l'en-tête x-request-id.
  requestId    String?
  ipAddress    String?
  userAgent    String?
  /// Contexte non sensible uniquement — jamais de mot de passe ni de jeton.
  metadata     Json?
  createdAt    DateTime       @default(now())

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  /// La SEULE lecture du journal : `listAuditLogs` pagine sans aucun filtre,
  /// `ORDER BY "createdAt" DESC, "id" DESC`. Aucun des index d'origine ne
  /// commençait par `createdAt`, donc aucun ne pouvait la servir : chaque
  /// page du back-office balayait puis triait une table append-only, jamais
  /// purgée, alimentée à chaque connexion et à chaque rafraîchissement. Un
  /// btree se parcourt dans les deux sens : pas besoin de `sort: Desc` ici.
  @@index([createdAt, id])
  /// Gardé, et il le mérite — contrairement à ce qu'une lecture rapide
  /// suggère, ce n'est PAS un index sans requête. La relation est
  /// `onDelete: SetNull` : supprimer un compte déclenche
  /// `UPDATE "AuditLog" SET "userId" = NULL WHERE "userId" = $1`. Sans cet
  /// index, l'effacement d'un compte — un droit, pas une option — balaierait
  /// tout le journal.
  @@index([userId, createdAt])
  /// Ajouté pour la même raison, et il manquait : `adminUser` est aussi en
  /// `onDelete: SetNull`, sans rien pour le servir.
  @@index([adminUserId])
}

// ───────────────────── Catalogue d'exercices (Étape 3) ─────────────────────

enum ExerciseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ExerciseType {
  STRENGTH
  CARDIO
  MOBILITY
  STRETCHING
}

enum ExerciseMuscleRole {
  PRIMARY
  SECONDARY
}

model MuscleGroup {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exerciseLinks ExerciseMuscle[]
}

model Equipment {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exerciseLinks ExerciseEquipment[]
  userLinks     UserEquipment[]
}

/// Matériel dont l'utilisateur DISPOSE — entrée de génération (Plan 4).
/// S'adosse à la taxonomie du catalogue (`Equipment`), jamais une liste
/// libre : la génération filtre les exercices par les mêmes slugs que le
/// coach. Écriture par remplacement complet de la liste, idempotente.
model UserEquipment {
  userId      String   @db.Uuid
  equipmentId String   @db.Uuid
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([userId, equipmentId])
  @@index([equipmentId])
}

/// Nature d'un média. La photo d'exercice et le maillage 3D suivent le MÊME
/// chemin — dépôt depuis l'admin, stockage objet, URL servie à l'application —
/// et ne se distinguent que par ce champ.
enum MediaKind {
  IMAGE
  MESH_3D
  VIDEO
}

/// Fichier déposé depuis l'administration et servi par le stockage objet.
///
/// Aucun média n'entre dans l'application par un autre chemin : ni asset
/// embarqué, ni URL écrite à la main. C'est ce qui permet d'ajouter une photo
/// ou un maillage sans publier une nouvelle version de l'app.
model MediaAsset {
  /// Fourni par l'administration : un dépôt rejoué ne crée pas de doublon.
  id           String    @id @db.Uuid
  kind         MediaKind
  /// Clé dans le bucket. Unique : deux médias ne partagent jamais un objet.
  storageKey   String    @unique
  mimeType     String
  byteSize     Int
  /// Images et vidéos seulement — un maillage n'a pas de dimensions en pixels.
  width        Int?
  height       Int?
  /// SHA-256 du contenu : reconnaître un fichier déjà déposé.
  checksum     String
  originalName String
  /// Administrateur ayant déposé le fichier. Conservé même s'il part.
  uploadedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// Suppression logique : l'objet reste en stockage tant qu'il est référencé.
  deletedAt    DateTime?

  uploadedBy     AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  exerciseImages Exercise[] @relation("ExerciseImage")
  exerciseMeshes Exercise[] @relation("ExerciseMesh")

  @@index([kind, createdAt])
  @@index([checksum])
}

model Exercise {
  id           String             @id @default(uuid()) @db.Uuid
  slug         String             @unique
  name         String
  description  String
  /// Étapes d'exécution, dans l'ordre.
  instructions String[]
  difficulty   ExerciseDifficulty
  type         ExerciseType
  /// Réservé aux abonnés — le droit effectif sera décidé côté serveur (Étape 6).
  isPremium    Boolean            @default(false)
  /// Un exercice non publié n'apparaît jamais dans le catalogue.
  isPublished  Boolean            @default(true)
  /// Retiré du catalogue depuis l'administration.
  ///
  /// SUPPRESSION DOUCE, et non `DELETE` : un exercice est cité par des séries
  /// déjà réalisées, des records et des modèles de séance. Le supprimer
  /// vraiment effacerait — ou trouerait — l'historique de gens qui n'ont rien
  /// demandé. La suppression force aussi `isPublished` à faux : tout le reste
  /// du code filtre déjà sur ce drapeau, l'exercice disparaît donc partout
  /// sans qu'aucune autre requête n'ait à connaître ce champ.
  deletedAt    DateTime?
  tags         String[]
  /// Photographie du mouvement, déposée depuis l'administration.
  imageId      String?            @db.Uuid
  /// Maillage 3D du mouvement (à venir) — même pipeline que la photo.
  meshId       String?            @db.Uuid
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  /// `SetNull` et non `Cascade` : supprimer un média ne supprime jamais un
  /// exercice — il le laisse simplement sans photo.
  image              MediaAsset?                @relation("ExerciseImage", fields: [imageId], references: [id], onDelete: SetNull)
  mesh               MediaAsset?                @relation("ExerciseMesh", fields: [meshId], references: [id], onDelete: SetNull)
  muscles            ExerciseMuscle[]
  equipment          ExerciseEquipment[]
  workoutSets        WorkoutSet[]
  templateExercises  WorkoutTemplateExercise[]
  sessionPlanItems   WorkoutSessionPlanItem[]
  personalRecords    PersonalRecord[]
  coachProposalItems CoachSessionProposalItem[]

  @@index([isPublished, name])
  @@index([deletedAt])
}

/// Groupes musculaires travaillés — exactement un rôle PRIMARY par exercice
/// (garanti par la couche application et le seed).
model ExerciseMuscle {
  exerciseId    String             @db.Uuid
  muscleGroupId String             @db.Uuid
  role          ExerciseMuscleRole

  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroup MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleGroupId])
  @@index([muscleGroupId])
}

model ExerciseEquipment {
  exerciseId  String @db.Uuid
  equipmentId String @db.Uuid

  exercise  Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([exerciseId, equipmentId])
  @@index([equipmentId])
}

// ─────────────────────────── Séances (Étape 4) ─────────────────────────────

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum WorkoutSetKind {
  WARMUP
  NORMAL
  DROP
}

/// Séance réelle. L'id est un UUID généré SUR L'APPAREIL (offline-first) :
/// la création est idempotente, rejouer la requête ne duplique rien.
model WorkoutSession {
  id              String               @id @db.Uuid
  userId          String               @db.Uuid
  name            String?
  notes           String?
  status          WorkoutSessionStatus @default(IN_PROGRESS)
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  /// Modèle lancé, s'il y en a un. SetNull : une purge physique du modèle
  /// n'efface jamais la séance.
  templateId   String? @db.Uuid
  /// Nom du modèle AU MOMENT DU LANCEMENT — dénormalisé, immuable :
  /// l'historique reste lisible même modèle supprimé ou renommé.
  templateName String?

  /// Jour de programme honoré par cette séance — ce qui rend une case du
  /// calendrier « faite ». Rempli au lancement depuis le calendrier, nul
  /// pour une séance libre.
  ///
  /// VOLONTAIREMENT SANS CLÉ ÉTRANGÈRE, et pour une raison mesurée : les
  /// lignes `ProgramDay` sont PHYSIQUEMENT détruites puis recréées à chaque
  /// enregistrement du programme (`programs.repository.ts`, `deleteMany`
  /// suivi de `createMany`), c'est-à-dire à chaque geste d'édition. Avec
  /// `SetNull`, cocher une case effacerait tous les liens séance ↔ jour ;
  /// avec `Restrict`, le PUT tomberait dès la première séance faite ; avec
  /// `Cascade`, on supprimerait des séances RÉALISÉES.
  ///
  /// Une référence par identifiant seul survit à ce cycle, parce que les
  /// identifiants sont stables : l'écran conserve celui de la case, et la
  /// génération le DÉRIVE de la position. La contrepartie est assumée — un
  /// lien peut pendre quand la case disparaît, et la séance redevient alors
  /// une séance libre. Perdre le lien vaut mieux que perdre l'historique.
  programDayId String? @db.Uuid

  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template        WorkoutTemplate?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sets            WorkoutSet[]
  planItems       WorkoutSessionPlanItem[]
  personalRecords PersonalRecord[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([templateId])
  /// Le calendrier lit « les séances de ces sept jours ». Sans cet index,
  /// chaque ouverture balaie tout l'historique du compte.
  @@index([programDayId])
}

/// Série PRÉVUE d'une séance : copie APLATIE du modèle au lancement.
///
/// Écrite en une fois avec la séance, elle rend la reprise MULTI-APPAREIL
/// possible : sans elle, un téléphone qui reprend une séance commencée
/// ailleurs voit les séries déjà faites mais plus aucune cible.
///
/// C'est une copie, pas un lien vivant : renommer ou supprimer le modèle
/// ensuite ne touche jamais une séance déjà lancée.
model WorkoutSessionPlanItem {
  id        String @id @db.Uuid
  sessionId String @db.Uuid

  /// Rang de l'exercice dans la séance, à partir de 0.
  exercisePosition Int
  exerciseId       String?        @db.Uuid
  /// Dénormalisé : le plan survit aux évolutions du catalogue.
  exerciseName     String
  /// Rang de la série DANS l'exercice, à partir de 0.
  setPosition      Int
  kind             WorkoutSetKind @default(NORMAL)
  targetReps       Int?
  targetWeightKg   Decimal?       @db.Decimal(6, 2)
  restSeconds      Int?

  /// Série qui a honoré cette prévision. VOLONTAIREMENT sans clé étrangère :
  /// hors ligne, la série peut encore être dans la file d'envoi de l'appareil
  /// quand l'appariement remonte. Une contrainte ferait échouer l'opération
  /// en 4xx, donc la perdrait, alors qu'un identifiant orphelin est sans
  /// conséquence — l'écran n'affiche que la présence de l'appariement.
  doneSetId String? @db.Uuid
  /// Prévision explicitement passée par l'utilisateur.
  skipped   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise?      @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@unique([sessionId, exercisePosition, setPosition])
  @@index([sessionId])
  @@index([exerciseId])
}

/// Série effectuée. Id généré sur l'appareil, écriture en upsert (rejouable).
/// exerciseName est dénormalisé : l'historique survit au catalogue.
model WorkoutSet {
  id              String         @id @db.Uuid
  sessionId       String         @db.Uuid
  exerciseId      String?        @db.Uuid
  exerciseName    String
  position        Int
  kind            WorkoutSetKind @default(NORMAL)
  reps            Int?
  weightKg        Decimal?       @db.Decimal(6, 2)
  durationSeconds Int?
  distanceMeters  Int?
  rpe             Int?
  restSeconds     Int?
  completedAt     DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  /// Cible AFFICHÉE quand l'utilisateur a validé cette série (null hors modèle).
  /// Fait historique : jamais modifiable après coup (PATCH ne les accepte pas).
  plannedReps     Int?
  plannedWeightKg Decimal? @db.Decimal(6, 2)

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise?      @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([sessionId, position])
}

// ───────────────────────── Modèles de séance ──────────────────────────────
//
// Documents PRESCRIPTIFS (ce qui est prévu), distincts des séances réalisées.
// Au lancement, le modèle est COPIÉ dans la séance : il n'y a aucun lien
// vivant, modifier un modèle ne réécrit jamais une séance passée.

/// Modèle de séance : ce que l'utilisateur a PRÉVU de faire, réutilisable.
/// L'id est un UUID généré SUR L'APPAREIL — l'écriture est rejouable.
model WorkoutTemplate {
  id                       String    @id @db.Uuid
  userId                   String    @db.Uuid
  name                     String
  notes                    String?
  /// Saisie facultative de l'utilisateur — JAMAIS calculée par le serveur.
  estimatedDurationMinutes Int?
  /// Dernier lancement : posé à la création d'une séance qui référence ce modèle.
  lastUsedAt               DateTime?
  /// Programme qui a engendré ce modèle — `null` pour un modèle écrit à la
  /// main. Une génération de huit semaines dépose jusqu'à plusieurs dizaines
  /// de modèles : sans cette colonne, la bibliothèque de la personne se
  /// noierait sous des séances qu'elle n'a pas composées et qu'elle ne
  /// saurait pas distinguer des siennes.
  generatedFromProgramId   String?   @db.Uuid
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises      WorkoutTemplateExercise[]
  sessions       WorkoutSession[]
  coachProposals CoachSessionProposal[]
  programDays    ProgramDay[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([generatedFromProgramId])
}

/// Ligne d'exercice prescrite dans un modèle, ordonnée.
/// exerciseName est dénormalisé : le modèle survit au catalogue.
model WorkoutTemplateExercise {
  id           String  @id @db.Uuid
  templateId   String  @db.Uuid
  exerciseId   String? @db.Uuid
  exerciseName String
  /// Entier contigu à partir de 0, dérivé de l'ordre du tableau reçu.
  /// L'unicité tient parce que le contenu est TOUJOURS réécrit intégralement.
  position     Int
  notes        String?

  template WorkoutTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise Exercise?            @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  sets     WorkoutTemplateSet[]

  @@unique([templateId, position])
  @@index([exerciseId])
}

/// Série prévue d'une ligne d'exercice. Cibles, pas mesures :
/// ce qui sera réellement fait vit dans WorkoutSet.
model WorkoutTemplateSet {
  id                 String         @id @db.Uuid
  templateExerciseId String         @db.Uuid
  position           Int
  kind               WorkoutSetKind @default(NORMAL)
  targetReps         Int?
  targetWeightKg     Decimal?       @db.Decimal(6, 2)
  /// Cibles des mouvements qui se comptent en TEMPS ou en DISTANCE : un
  /// gainage, une course, un rameur. Elles existent parce que `targetReps`
  /// ne sait pas les dire : y écrire « 45 » pour quarante-cinq secondes de
  /// planche ferait entrer « 45 répétitions » dans les records personnels,
  /// et les y laisserait — le fait est dénormalisé et ne se rattrape pas.
  /// La série RÉALISÉE porte déjà les deux (`WorkoutSet`) : c'est la
  /// PRESCRIPTION qui ne savait pas les exprimer.
  targetDurationSeconds Int?
  targetDistanceMeters  Int?
  restSeconds        Int?

  templateExercise WorkoutTemplateExercise @relation(fields: [templateExerciseId], references: [id], onDelete: Cascade)

  @@unique([templateExerciseId, position])
}

// ────────────────────────── Progression (Étape 5) ──────────────────────────

enum PersonalRecordType {
  MAX_WEIGHT
  MAX_REPS
  MAX_SET_VOLUME
}

/// Records personnels, recalculés à la clôture de chaque séance.
/// Clé par exerciseName (dénormalisé) : les records survivent au catalogue.
model PersonalRecord {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @db.Uuid
  exerciseId   String?            @db.Uuid
  exerciseName String
  recordType   PersonalRecordType
  /// kg, répétitions ou kg de volume selon recordType.
  value        Decimal            @db.Decimal(10, 2)
  reps         Int?
  weightKg     Decimal?           @db.Decimal(6, 2)
  achievedAt   DateTime
  sessionId    String?            @db.Uuid
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise?       @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  session  WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([userId, exerciseName, recordType])
  @@index([userId, achievedAt])
}

/// Ce qu'un franchissement peut être.
enum MilestoneKind {
  /// Un record BATTU, ce jour-là. Dérivé des séries, jamais saisi.
  RECORD
  /// Une récompense du catalogue, décidée par le moteur du mobile.
  REWARD
  /// Un palier de titre Carlys franchi.
  TITLE
}

/// Un FRANCHISSEMENT daté — la matière propre d'une frise de progression.
///
/// Pourquoi une table, quand séances, mesures et leçons restent dérivées à
/// la lecture : ce sont les trois seuls événements qui ne correspondent à
/// AUCUNE ligne existante. `PersonalRecord` ne garde que le maximum courant
/// (un 80 kg en mars puis un 85 en avril, et il ne reste que le 85) ; la
/// récompense n'existe nulle part côté serveur ; et le titre dépend d'un
/// score calculé sur une fenêtre MOBILE, que rejouer ici demanderait de
/// réécrire le moteur Dart en TypeScript et de le maintenir en double.
///
/// L'unicité porte la règle du journal local sur le serveur — « la première
/// gagne, rien ne s'efface » devient un `ON CONFLICT DO NOTHING`.
model ProgressMilestone {
  id     String        @id @default(uuid()) @db.Uuid
  userId String        @db.Uuid
  kind   MilestoneKind
  /// Clé STABLE du franchissement, gelée comme les identifiants du catalogue
  /// de récompenses : `constance-4`, `titre-artisan`,
  /// `record:<exercice>|MAX_WEIGHT|<valeur>`.
  key    String
  /// La date du FAIT, jamais celle de l'inscription. Le journal local datait
  /// une récompense du jour où l'application avait regardé, ce qui la plaçait
  /// systématiquement APRÈS ce qui l'avait méritée — sur une frise
  /// chronologique, ça se lit comme un mensonge.
  occurredAt DateTime
  /// Libellé, valeur, exercice : de quoi écrire la ligne sans rejouer le
  /// calcul. Jamais interrogé, seulement rendu.
  payload    Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, key])
  @@index([userId, occurredAt(sort: Desc)])
}

enum BodyMetricType {
  WEIGHT_KG
  BODY_FAT_PERCENT
}

/// Mesure corporelle. Id généré côté client (création idempotente).
model BodyMetric {
  id         String         @id @db.Uuid
  userId     String         @db.Uuid
  metricType BodyMetricType
  value      Decimal        @db.Decimal(6, 2)
  measuredAt DateTime
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, metricType, measuredAt])
}

// ─────────────────────────── Abonnements (Étape 6) ───────────────────────────

enum PaymentProvider {
  STRIPE
  REVENUECAT
  APP_STORE
  PLAY_STORE
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

/// Plan commercial interne, indépendant des fournisseurs de paiement.
model SubscriptionPlan {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products      SubscriptionProduct[]
  subscriptions Subscription[]
  entitlements  SubscriptionPlanEntitlement[]
}

/// Les droits qu'un plan ouvre — la correspondance plan → entitlements, EN
/// DONNÉE.
///
/// C'est ce que l'ADR 0006 exige, et ce qui manquait : « aucun test de nom de
/// plan en dur (`plan === "premium"` est interdit en revue) ; toute condition
/// d'accès nomme un droit ». Le calcul des droits reconnaissait le plan à son
/// slug et réécrivait, à chaque événement, la liste des droits premium codée
/// dans `packages/api-contracts`. Un second plan payant — un plan « coach »,
/// ou simplement un tarif distinct — aurait donc rétrogradé par son propre
/// achat un membre déjà Premium : le nouvel abonnement ne « valant » pas
/// premium, la boucle écrivait `isActive: false` sur tous ses droits, sans
/// erreur et avec l'événement marqué traité.
model SubscriptionPlanEntitlement {
  planId         String   @db.Uuid
  entitlementKey String
  createdAt      DateTime @default(now())

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, entitlementKey])
}

/// Correspondance plan interne ↔ produit chez un fournisseur.
model SubscriptionProduct {
  id                String          @id @default(uuid()) @db.Uuid
  planId            String          @db.Uuid
  provider          PaymentProvider
  externalProductId String
  billingPeriod     BillingPeriod
  createdAt         DateTime        @default(now())

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([provider, externalProductId])
}

/// État courant de l'abonnement, projeté depuis les événements fournisseurs.
model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @db.Uuid
  planId                 String             @db.Uuid
  provider               PaymentProvider
  externalSubscriptionId String
  status                 SubscriptionStatus
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  trialEndsAt            DateTime?
  /// Client chez le fournisseur (Stripe : `cus_…`), appris par webhook :
  /// réutilisé au prochain paiement, requis pour le portail de gestion.
  externalCustomerId     String?
  /// Date d'ÉMISSION du dernier événement appliqué, telle que le fournisseur
  /// l'a datée (Stripe `created`, RevenueCat `event_timestamp_ms`) — pas la
  /// date de réception. C'est la garde contre le rembobinage : les webhooks
  /// n'arrivent pas dans l'ordre d'émission (réessais, parallélisme côté
  /// fournisseur), et l'écriture était inconditionnelle. Un
  /// `customer.subscription.updated` émis AVANT un renouvellement mais livré
  /// APRÈS écrasait la période à jour par l'ancienne, et coupait l'accès d'un
  /// membre qui venait de payer. `null` : aucun événement daté appliqué
  /// encore — la garde laisse alors passer, faute de pouvoir comparer.
  lastEventAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan    @relation(fields: [planId], references: [id])
  events       SubscriptionEvent[]
  entitlements UserEntitlement[]

  @@unique([provider, externalSubscriptionId])
  @@index([userId, status])
}

/// Journal APPEND-ONLY des webhooks reçus — la garantie d'idempotence :
/// un événement (provider, externalEventId) n'est traité qu'une seule fois.
model SubscriptionEvent {
  id              String          @id @default(uuid()) @db.Uuid
  provider        PaymentProvider
  externalEventId String
  eventType       String
  /// JSON brut du webhook (usage légitime du JSON : trace de traitement).
  payload         Json
  receivedAt      DateTime        @default(now())
  processedAt     DateTime?
  processingError String?
  subscriptionId  String?         @db.Uuid

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([receivedAt])
}

/// Source de vérité SERVEUR des droits effectifs, matérialisée pour une
/// lecture O(1). Peut aussi être accordé manuellement (Étape 7, audité).
model UserEntitlement {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  entitlementKey       String
  isActive             Boolean   @default(false)
  expiresAt            DateTime?
  sourceSubscriptionId String?   @db.Uuid
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceSubscription Subscription? @relation(fields: [sourceSubscriptionId], references: [id], onDelete: SetNull)

  @@unique([userId, entitlementKey])
  @@index([userId, isActive])
}

// ────────────────────────── Administration (Étape 7) ──────────────────────────

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

/// Compte d'administration — JAMAIS confondu avec User (comptes mobiles).
model AdminUser {
  id           String          @id @default(uuid()) @db.Uuid
  /// Normalisé en minuscules par la couche application avant écriture.
  email        String          @unique
  /// Hash Argon2id — jamais le mot de passe, jamais loggé, jamais retourné.
  passwordHash String
  displayName  String
  status       AdminUserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  roles       AdminUserRole[]
  auditLogs   AuditLog[]
  /// Médias déposés par cet administrateur.
  mediaAssets MediaAsset[]
}

/// Rôle nommé (ex. superadmin, support, content-manager).
model AdminRole {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  name        String
  description String?

  users       AdminUserRole[]
  permissions AdminRolePermission[]
}

/// Permission granulaire, seedée par le code (source de vérité de la liste).
model AdminPermission {
  id       String @id @default(uuid()) @db.Uuid
  resource String
  action   String

  roles AdminRolePermission[]

  @@unique([resource, action])
}

model AdminUserRole {
  adminUserId String @db.Uuid
  roleId      String @db.Uuid

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
}

model AdminRolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ─────────────────────────────── Coach IA ─────────────────────────────────
//
// L'IA PROPOSE, l'application EXÉCUTE. Le coach n'a aucun outil d'écriture :
// sa seule sortie structurée est une proposition de séance, que l'utilisateur
// accepte explicitement. La création passe ensuite par le chemin de séance
// existant — idempotent, hors ligne, rejouable.

enum CoachMessageRole {
  USER
  ASSISTANT
}

/// Fil de discussion. L'id vient de l'appareil : le premier message peut être
/// composé avant que le serveur n'ait jamais entendu parler du fil.
model CoachConversation {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  /// Résumé court du fil, écrit par le coach au premier échange.
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CoachMessage[]

  @@index([userId, updatedAt(sort: Desc)])
}

model CoachMessage {
  id             String           @id @db.Uuid
  conversationId String           @db.Uuid
  role           CoachMessageRole
  content        String
  /// Jetons consommés par CE message (rôle ASSISTANT uniquement) —
  /// observabilité du coût, jamais de la facturation.
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime         @default(now())

  conversation CoachConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  proposal     CoachSessionProposal?

  @@index([conversationId, createdAt])
}

/// Séance proposée par le coach. Tant qu'elle n'est pas acceptée, ce n'est
/// qu'un document : elle ne compte NI dans l'historique, NI dans les
/// statistiques, NI dans les records.
model CoachSessionProposal {
  id                String   @id @db.Uuid
  messageId         String   @unique @db.Uuid
  name              String
  /// Durée annoncée à l'utilisateur, en minutes.
  estimatedMinutes  Int
  /// Modèle dont la proposition est dérivée, s'il y en a un.
  sourceTemplateId  String?  @db.Uuid
  /// Séance réellement lancée depuis cette proposition. Posé par l'application
  /// à l'acceptation ; sert à mesurer ce que le coach fait vraiment démarrer.
  /// VOLONTAIREMENT sans clé étrangère : la séance naît sur l'appareil et peut
  /// être encore dans la file d'envoi quand l'acceptation remonte.
  acceptedSessionId String?  @db.Uuid
  createdAt         DateTime @default(now())

  message  CoachMessage               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  template WorkoutTemplate?           @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  items    CoachSessionProposalItem[]
}

/// Série proposée — MÊME FORME que `WorkoutSessionPlanItem`, volontairement :
/// l'acceptation est alors une copie, pas une traduction.
model CoachSessionProposalItem {
  id         String @id @db.Uuid
  proposalId String @db.Uuid

  exercisePosition Int
  /// Clé étrangère FERME, contrairement à l'historique où un exercice supprimé
  /// ne doit jamais effacer une séance passée. Une proposition n'est pas de
  /// l'historique : si l'exercice n'existe pas, elle n'a aucune raison
  /// d'exister. C'est la base qui rend l'invention impossible, pas le code.
  exerciseId       String         @db.Uuid
  /// Dénormalisé comme partout ailleurs : la proposition reste lisible même
  /// si le catalogue évolue entre la proposition et sa lecture.
  exerciseName     String
  setPosition      Int
  kind             WorkoutSetKind @default(NORMAL)
  targetReps       Int?
  targetWeightKg   Decimal?       @db.Decimal(6, 2)
  restSeconds      Int?

  proposal CoachSessionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  exercise Exercise             @relation(fields: [exerciseId], references: [id])

  @@unique([proposalId, exercisePosition, setPosition])
  @@index([proposalId])
  @@index([exerciseId])
}

// ──────────────────────── Défis entre amis ────────────────────────────────
//
// TABLES SÉPARÉES de `CommunityChallenge`, et pour des raisons mesurées, pas
// par goût de la symétrie :
//
//  - la lecture des défis collectifs n'a AUCUN prédicat de visibilité
//    (`listOpenChallenges` filtre sur la seule fenêtre de dates) parce qu'elle
//    n'en a jamais eu besoin : y glisser des défis d'utilisateurs exposerait
//    le défi de chacun à tout le monde, instantanément ;
//  - `@@unique([slug, month])` EST l'identité d'un défi de catalogue. Un défi
//    entre amis n'a ni slug ni mois ;
//  - la sémantique du DÉPART est inverse. Quitter un défi collectif garde la
//    contribution acquise, parce qu'un compteur collectif ne peut que monter ;
//    quitter un défi entre amis doit RETIRER du classement, qui est
//    individuel. Deux règles opposées sur la même colonne ;
//  - rejoindre un défi collectif est un simple upsert : il n'y a pas d'état
//    « invité, pas encore accepté », et c'est tout l'objet de celui-ci.
//
// Ce qui EST partagé : `ChallengeMetric` et le chemin d'écriture des
// contributions. Deux compteurs séparés dériveraient.

enum FriendChallengeStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum FriendChallengeMemberStatus {
  INVITED
  ACCEPTED
  DECLINED
  LEFT
}

/// Un défi lancé par quelqu'un à ses amis.
model FriendChallenge {
  /// UUID fourni par l'appareil : rejouer la création ne crée pas de doublon.
  id           String                @id @db.Uuid
  creatorId    String                @db.Uuid
  title        String
  /// Le mot du créateur à ses invités (280 points de code au plus, découpé
  /// à l'entrée : au plus 560 unités UTF-16 en base), NULL s'il n'a rien
  /// écrit. Son heure est `createdAt` : il naît avec le défi et ne se
  /// modifie pas, pas même par un rejeu de la création. Lu par les seuls
  /// membres, jamais porté par la notification, et masqué au lecteur qu'un
  /// blocage sépare du créateur.
  message      String?
  metric       ChallengeMetric
  /// Objectif commun, ou `null` pour un « qui en fait le plus ».
  target       Int?
  /// 3, 7 ou 30 — borné par le DTO, donc extensible sans migration.
  durationDays Int
  startsAt     DateTime
  /// CALCULÉ par le serveur (`startsAt` + `durationDays`), jamais reçu du
  /// client : une fin fournie par l'appelant est un défi éternel en une
  /// requête.
  endsAt       DateTime
  status       FriendChallengeStatus @default(OPEN)
  /// Posé UNE fois par la clôture paresseuse, et clé de son idempotence :
  /// l'écriture est conditionnée à sa nullité, donc deux lectures
  /// simultanées d'un défi échu n'en règlent qu'une.
  closedAt     DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  creator User                    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members FriendChallengeMember[]
  /// Signalements qui visent ce défi (son titre ou son message).
  reports CommunityReport[]

  @@index([creatorId])
  @@index([status, endsAt])
}

model FriendChallengeMember {
  challengeId String                      @db.Uuid
  userId      String                      @db.Uuid
  status      FriendChallengeMemberStatus @default(INVITED)
  invitedById String                      @db.Uuid
  /// Dans l'unité de `FriendChallenge.metric`, jamais un `+1` en dur.
  contribution Int                        @default(0)
  joinedAt    DateTime?
  leftAt      DateTime?
  /// Figé à la clôture, nul avant : le classement d'un défi terminé ne doit
  /// plus bouger, même si quelqu'un continue à s'entraîner.
  finalRank   Int?

  challenge FriendChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([challengeId, userId])
  @@index([userId, status])
}

// ─────────────────────────── Journal alimentaire ──────────────────────────

/// L'unité dans laquelle une quantité se dit. Quatre, parce que c'est ce
/// qu'on lit sur un emballage ou dans une assiette : des grammes, des
/// millilitres, une portion, une pièce.
enum MealQuantityUnit {
  GRAM
  MILLILITER
  PORTION
  PIECE
}

/// Entrée du journal alimentaire : ce que l'utilisateur dit avoir mangé.
///
/// C'est la moitié RÉELLE du « 654 / 2 100 » de l'accueil : le consommé vient
/// d'ici, l'objectif du profil métabolique. Id généré SUR L'APPAREIL
/// (création idempotente, rejouable) ; `eatenAt` est un INSTANT UTC — le
/// découpage en journées appartient au client, qui connaît son fuseau.
model MealEntry {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  name      String
  kcal      Int
  /// Ce qui a été mangé, en clair : « 250 g », « 1,5 portion », « 2 pièces ».
  ///
  /// PUREMENT DESCRIPTIVE : elle ne multiplie NI `kcal` NI les macros, qui
  /// restent le TOTAL réellement consommé. La rendre multiplicatrice
  /// changerait le sens de `kcal` — il cesserait de dire « ce repas » pour
  /// dire « une unité de ce repas » — et les bornes de saisie (10 000 kcal,
  /// 1 000 g par macro) sont des bornes de REPAS, pas d'unité.
  ///
  /// Nullable et sans défaut, comme les macros l'ont été à leur arrivée :
  /// poser un 1 aux entrées déjà enregistrées redéfinirait après coup ce que
  /// la personne a saisi, et la première correction de 1 à 2 doublerait un
  /// nombre qu'elle avait tapé comme un total.
  ///
  /// Les deux champs vont PAR PAIRE : une quantité sans unité ne dit rien.
  quantity     Decimal?          @db.Decimal(7, 2)
  quantityUnit MealQuantityUnit?
  /// Les trois macros, toutes FACULTATIVES et indépendantes : une entrée
  /// rapide n'en porte aucune, une estimation les porte toutes, et une
  /// saisie à la main peut n'en connaître qu'une. `null` veut dire « on ne
  /// sait pas », jamais « zéro » — l'écran doit pouvoir faire la différence.
  ///
  /// L'écran affichait quatre macros CIBLES et n'en journalisait que deux :
  /// la comparaison consommé / objectif était impossible sur les deux tiers
  /// de ce qu'il montrait.
  proteinG  Int?
  carbsG    Int?
  fatG      Int?
  eatenAt   DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eatenAt])
}

// ────────────────────────────── Communauté ────────────────────────────────
//
// La séparation public/privé est une décision SERVEUR : ce que voit un ami
// est décidé ici, jamais par le client. Le nom d'affichage est la seule
// donnée toujours visible ; la progression (série, séances de la semaine)
// n'est servie que si son propriétaire la partage.

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// Préférence communautaire de l'utilisateur. Table à part de UserProfile :
/// le partage de progression est un choix communautaire, pas une donnée
/// d'identité — et son absence vaut « partagé » (défaut confirmé au premier
/// passage sur l'écran Communauté).
model CommunityPreference {
  userId         String   @id @db.Uuid
  sharesProgress Boolean  @default(true)
  /// Participation à la LIGUE, et son défaut est l'inverse du précédent :
  /// `false`. Y entrer EST le consentement — le « périmètre CHOISI » du
  /// principe 5. Réglage DISTINCT de `sharesProgress`, qui décide si un AMI
  /// voit ta progression : il n'a jamais promis de montrer ton nom et ton
  /// score à dix-neuf inconnus.
  joinsLeague    Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Les cinq divisions, de la plus basse à la plus haute. L'ordre de
/// déclaration EST le barème : `LEAGUE_LADDER` (`league-ladder.ts`) le
/// recopie, et un test compare les deux listes.
enum LeagueDivision {
  BRONZE
  ARGENT
  OR
  PLATINE
  DIAMANT
}

/// La place de quelqu'un dans une ligue, pour UNE période.
///
/// Une ligne par (personne, semaine ISO). Elle naît à la première écriture
/// d'effort ou à la première lecture de la semaine, et la division qu'elle
/// porte vient de la dernière période réglée — défaut BRONZE.
///
/// Aucune tâche planifiée ne la clôt : la première lecture d'une période
/// postérieure fige les rangs (`finalRank`) et pose `settledAt`, l'écriture
/// étant conditionnée à sa nullité. Barème complet et raisons :
/// `docs/product/community.md`, « Les ligues, barème complet ».
model LeagueMembership {
  userId    String         @db.Uuid
  /// Semaine ISO en UTC, `YYYY-Www` — jamais un instant : une période est
  /// un fait CIVIL, et un instant se décale d'un fuseau à l'autre.
  periodKey String
  division  LeagueDivision
  /// Points de la période, jamais l'unité brute d'une métrique : le barème
  /// (`POINTS_PER_METRIC`) convertit avant d'incrémenter, sans quoi les
  /// mètres écraseraient les séances de deux ordres de grandeur.
  score     Int            @default(0)
  /// Figé au règlement, nul avant.
  finalRank Int?
  /// La division que le règlement a décidée pour la SUITE — et le seul
  /// endroit où une montée survit. Sans elle, la période suivante rouvrirait
  /// dans `division`, et le classement de la semaine passée n'aurait servi à
  /// rien ; l'écrire ici évite surtout d'ouvrir une ligne par semaine
  /// d'absence juste pour porter l'information.
  nextDivision LeagueDivision?
  settledAt DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, periodKey])
  /// Sert les deux lectures chaudes : le classement d'une division pour une
  /// période, et la recherche des périodes non réglées.
  @@index([periodKey, division, score(sort: Desc)])
  @@index([userId, periodKey(sort: Desc)])
}

/// Lien d'amitié. UNE ligne par paire, créée PENDING par la demande ; la
/// direction (qui a demandé) est conservée pour l'affichage des demandes.
/// L'unicité de la paire dans LES DEUX SENS est imposée par le service :
/// une contrainte symétrique n'est pas exprimable en Prisma.
model Friendship {
  id          String              @id @default(uuid()) @db.Uuid
  requesterId String              @db.Uuid
  addresseeId String              @db.Uuid
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?
  /// La PAIRE, ordonnée : les deux mêmes identifiants, toujours dans le même
  /// ordre, quel que soit le sens de la demande. C'est la seule forme qu'une
  /// base sait rendre unique. L'unicité dirigée `(requesterId, addresseeId)`
  /// laissait passer deux lignes pour une même paire dès que les deux
  /// personnes se demandaient en même temps : chacune lisait « pas de lien »,
  /// chacune écrivait la sienne, et accepter l'une laissait l'autre en
  /// attente pour toujours dans la liste des demandes reçues.
  userLowId   String              @db.Uuid
  userHighId  String              @db.Uuid

  requester User @relation("FriendshipsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

/// Mot envoyé à un ami. Le nom de l'expéditeur est lu au moment de servir le
/// fil (pas dénormalisé) : un fil social montre le nom COURANT des gens.
model Encouragement {
  id          String   @id @default(uuid()) @db.Uuid
  senderId    String   @db.Uuid
  recipientId String   @db.Uuid
  message     String
  createdAt   DateTime @default(now())

  sender    User              @relation("EncouragementsSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User              @relation("EncouragementsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  reports   CommunityReport[]

  @@index([recipientId, createdAt(sort: Desc)])
}

/// Blocage : décision UNILATÉRALE et opaque. Bloquer retire l'amitié et les
/// demandes en attente dans les deux sens ; ensuite, pour chacun des deux,
/// l'autre n'existe plus (code ami muet, demande muette, encouragement
/// refusé, absent des listes). Jamais de « tu es bloqué » : la réponse est
/// celle d'un compte inexistant.
model CommunityBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("CommunityBlocksIssued", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("CommunityBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

enum CommunityReportReason {
  HARCELEMENT
  SPAM
  CONTENU_INAPPROPRIE
  AUTRE
}

enum CommunityReportStatus {
  OPEN
  RESOLVED
}

/// Signalement d'une personne et, le cas échéant, d'un encouragement précis
/// OU d'un défi entre amis qu'elle a créé (jamais les deux à la fois).
/// Lu et résolu par l'administration (permission `community:moderate`),
/// jamais visible de la personne signalée. Si l'encouragement est supprimé
/// entre-temps, le signalement reste (référence mise à NULL) et son texte,
/// figé dans `encouragementMessage` au moment du signalement, aussi : la
/// preuve ne s'efface pas avec le message. Même règle pour un défi : titre
/// et message figés dans `friendChallengeTitle` et `friendChallengeMessage`.
model CommunityReport {
  id                     String                @id @default(uuid()) @db.Uuid
  reporterId             String                @db.Uuid
  reportedUserId         String                @db.Uuid
  encouragementId        String?               @db.Uuid
  /// Cliché du texte visé, pris dans la même transaction que le signalement.
  /// NULL quand le signalement vise la personne en général.
  encouragementMessage   String?
  /// Défi entre amis visé, exclusif avec `encouragementId`. Son créateur est
  /// la personne signalée : le titre et le message sont les siens. Mis à
  /// NULL si le défi disparaît ; les clichés ci-dessous restent.
  friendChallengeId      String?               @db.Uuid
  /// Cliché du titre du défi visé, pris dans la même transaction que le
  /// signalement. NULL quand le signalement ne vise aucun défi.
  friendChallengeTitle   String?
  /// Cliché du message du défi visé, pris dans la même transaction. NULL
  /// aussi quand ce défi n'en portait pas : c'est alors le titre seul que
  /// l'on signale.
  friendChallengeMessage String?
  reason                 CommunityReportReason
  /// Précisions libres (500 caractères au plus, validées à l'entrée).
  details                String?
  status                 CommunityReportStatus @default(OPEN)
  createdAt              DateTime              @default(now())
  resolvedAt             DateTime?

  reporter        User             @relation("CommunityReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser    User             @relation("CommunityReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  encouragement   Encouragement?   @relation(fields: [encouragementId], references: [id], onDelete: SetNull)
  friendChallenge FriendChallenge? @relation(fields: [friendChallengeId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([reportedUserId])
}

enum ChallengeKind {
  SPORT
  CULTURE
}

/// CE QU'UN DÉFI COMPTE, et dans quelle unité.
///
/// `kind` ne disait que la FAMILLE (sport ou culture) ; l'unité, elle, vivait
/// en prose dans le catalogue et en `+1` codé en dur dans deux méthodes du
/// dépôt. Un défi « 500 km ensemble » était donc impossible à exprimer, et
/// un défi « 500 séances » ne savait pas dire ce que valait une unité.
///
/// Les quatre valeurs présentes ont toutes une SOURCE RÉELLE aujourd'hui :
/// la clôture d'une séance (une séance, ses secondes d'effort, ses mètres
/// parcourus) et la première bonne réponse du jour à une leçon. Les pas et
/// l'eau n'en ont pas — les pas ne sont pas lus, l'eau ne quitte pas
/// l'appareil — et ils ne figurent donc pas ici : une valeur d'enum que rien
/// n'alimente est une promesse qu'aucun écran ne peut tenir.
///
/// Toutes sont des ÉVÉNEMENTS, jamais des totaux redéclarés : elles
/// s'additionnent par incrément, ce qui suppose que le même fait ne se
/// produise qu'une fois (une clôture de séance est gardée par sa transition
/// d'état, une réponse de quiz par son unicité). Le jour où une métrique
/// REDÉCLARE un total — les pas d'hier resynchronisés — l'incrément devient
/// faux, et il faudra un registre de totaux quotidiens avec un delta.
enum ChallengeMetric {
  /// Séances terminées, une par clôture.
  WORKOUTS
  /// Bonnes réponses, une par leçon et par jour.
  QUIZ_CORRECT
  /// Secondes d'effort réellement chronométrées dans les séries.
  ACTIVE_SECONDS
  /// Mètres parcourus, déclarés série par série.
  DISTANCE_METERS
}

/// Défi COLLECTIF — jamais créé par un utilisateur. Le jeu du mois est
/// matérialisé PARESSEUSEMENT à la première lecture d'un mois sans défi,
/// depuis le catalogue en code (`community/domain/challenge-catalog.ts`) :
/// pas de tâche planifiée, et l'unicité (slug, mois) absorbe les lectures
/// concurrentes. La progression est la somme des contributions rapportée à
/// l'objectif : la barre raconte l'effort commun.
model CommunityChallenge {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String
  /// Mois du défi, `YYYY-MM` en UTC : la clé d'idempotence du jeu du mois.
  month       String
  kind        ChallengeKind
  /// L'unité réellement comptée. Rétro-remplie depuis `kind` à l'arrivée de
  /// la colonne (SPORT → WORKOUTS, CULTURE → QUIZ_CORRECT) : les défis déjà
  /// en base comptaient bien ces deux choses-là, la colonne ne fait que le
  /// dire enfin.
  metric      ChallengeMetric
  title       String
  description String
  /// Objectif collectif (séances, bonnes réponses…).
  target      Int
  startsAt    DateTime      @default(now())
  endsAt      DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  participations ChallengeParticipation[]

  @@unique([slug, month])
  @@index([month])
  @@index([endsAt])
}

/// Réponse à une question de l'Academy — la source des défis CULTURE.
///
/// Une ligne par (utilisateur, leçon, jour local) : la création est
/// idempotente, rejouer la même réponse ne compte jamais deux fois.
/// `answeredOn` est le jour LOCAL de l'appareil (YYYY-MM-DD) — le serveur ne
/// découpe pas les journées, même principe que le journal alimentaire.
model QuizAnswer {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  /// Identifiant de la leçon du pack embarqué (contenu éditorial).
  lessonId   String
  answeredOn String
  correct    Boolean
  /// Index du choix retenu, pour reconstruire la carte de quiz sur un
  /// nouvel appareil (afficher la bonne réponse sans montrer le choix fait
  /// laisserait croire à une réussite). Nul sur les réponses d'avant la
  /// migration : on sait « abordée », pas « quoi ».
  choiceIndex Int?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, answeredOn])
  @@index([userId, createdAt])
}

model ChallengeParticipation {
  challengeId  String   @db.Uuid
  userId       String   @db.Uuid
  /// Contribution individuelle à l'objectif collectif. Pour les défis SPORT,
  /// incrémentée à la clôture de chaque séance pendant la fenêtre du défi.
  contribution Int      @default(0)
  joinedAt     DateTime @default(now())
  /// Départ du défi. La ligne SURVIT au départ : la contribution déjà versée
  /// appartient à l'objectif COLLECTIF, pas à celui qui l'a versée. Effacer
  /// la ligne faisait reculer un compteur qui ne peut que monter — les autres
  /// participants voyaient la barre du mois redescendre sans rien y pouvoir.
  /// Rejoindre à nouveau remet ce champ à `null`.
  leftAt       DateTime?

  challenge CommunityChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([challengeId, userId])
  @@index([userId])
}

/// Familles de notifications réglables séparément. Une seule bascule pour
/// tout couperait le lien social avec le rappel d'entraînement, qui n'ont
/// rien à voir.
enum NotificationCategory {
  FRIEND_REQUESTS
  ENCOURAGEMENTS
  /// Invitations à un défi entre amis. Une famille À PART : quelqu'un peut
  /// vouloir des encouragements sans vouloir être défié, et l'inverse.
  CHALLENGE_INVITES
}

enum DevicePlatform {
  ANDROID
  IOS
}

/// Jeton d'appareil pour les notifications push (FCM).
///
/// Un jeton appartient à UN utilisateur à la fois : se connecter avec un
/// autre compte sur le même appareil réaffecte le jeton (upsert par `token`).
/// Les jetons invalidés par FCM sont purgés au fil des envois.
model DeviceToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Ce qu'une personne accepte de recevoir, par CATÉGORIE.
///
/// Absence de ligne = accepté. Le réglage n'existe donc que pour ce qui a été
/// explicitement refusé : personne n'a besoin d'ouvrir les réglages pour que
/// l'application se comporte normalement, et une catégorie ajoutée plus tard
/// n'arrive pas coupée pour tout le monde.
///
/// La coupure est respectée CÔTÉ SERVEUR, à l'envoi : une préférence que
/// seul le téléphone connaîtrait laisserait la notification arriver quand
/// même, et ne servirait à rien.
model NotificationPreference {
  userId    String               @db.Uuid
  category  NotificationCategory
  enabled   Boolean              @default(true)
  updatedAt DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
}

/// Programme multi-semaines : un plan d'entraînement dans le temps.
///
/// Un programme n'est PAS un modèle de séance : le modèle décrit le contenu
/// d'une séance, le programme décrit à quel moment la faire. Il ne duplique
/// donc aucun exercice — chaque jour pointe vers un modèle existant, ou
/// n'annonce qu'un intitulé (repos, activité libre).
///
/// Comme le modèle de séance : identifiant fourni par l'appareil (création
/// hors ligne), contenu TOUJOURS réécrit intégralement, suppression logique.
model Program {
  id          String    @id @db.Uuid
  userId      String    @db.Uuid
  name        String
  description String?
  /// Nombre de semaines du plan (1 à 52). Les jours au-delà sont refusés.
  weeksCount  Int
  /// Programme suivi en ce moment. UN SEUL par utilisateur : deux programmes
  /// « en cours » n'ont aucun sens, l'application ne saurait lequel afficher.
  /// PostgreSQL ne peut pas l'exprimer ici (il faudrait un index unique
  /// PARTIEL, hors du vocabulaire Prisma), c'est donc le service qui l'impose,
  /// en désactivant les autres dans la même transaction.
  isActive    Boolean   @default(false)
  /// Premier jour RÉEL du plan — une DATE CIVILE, jamais un instant.
  ///
  /// C'est elle qui donne une date à chaque case : la grille est ancrée au
  /// LUNDI de sa semaine, et `date(semaine, jour) = lundi + 7×(s−1) + (j−1)`.
  /// La grille reste donc alignée sur les jours de la semaine, que le
  /// générateur utilise pour espacer les séances ; et les jours de la
  /// semaine 1 ANTÉRIEURS à `startsOn` sont « hors période » — ni faits, ni
  /// manqués. Sans cette nuance, commencer un mercredi afficherait deux
  /// jours manqués avant même la première séance.
  ///
  /// `@db.Date` et non `DateTime` : stockée en instant, elle traverserait le
  /// contrat en ISO 8601 complet et le mobile lui appliquerait le
  /// `.toLocal()` qu'il applique à tout le reste — à raison, puisque tout le
  /// reste EST un instant. Le 21 deviendrait le 20 à l'ouest de Greenwich.
  ///
  /// Nullable : les programmes déjà enregistrés n'en ont pas, et un
  /// `NOT NULL` sans défaut casserait la migration sur une table peuplée.
  /// Sans date, un programme reste ce qu'il a toujours été — une GRILLE
  /// (semaine N, jour J), sans calendrier.
  startsOn    DateTime? @db.Date
  /// Rapport de la génération qui a produit ce programme — `null` s'il a été
  /// composé à la main. Écrit UNE fois, jamais relu par le moteur.
  ///
  /// C'est ce qui rend la tranche auditable au-delà de l'instant : sans lui,
  /// un support qui ouvre un programme trois semaines plus tard ne peut plus
  /// expliquer pourquoi tel exercice y figure ni quelle règle a dû céder —
  /// il faudrait régénérer, et le profil aura bougé entre-temps. C'est
  /// justement la première chose qu'on change quand un programme déçoit.
  generationReport Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  days ProgramDay[]

  @@index([userId, updatedAt(sort: Desc)])
}

/// Une case du calendrier du programme : semaine N, jour J.
model ProgramDay {
  id         String  @id @db.Uuid
  programId  String  @db.Uuid
  /// 1 à `weeksCount`.
  weekNumber Int
  /// 1 (lundi) à 7 (dimanche).
  dayOfWeek  Int
  /// Modèle à jouer ce jour-là. `SetNull` : supprimer un modèle vide la case,
  /// il ne fait jamais disparaître le programme.
  templateId String? @db.Uuid
  /// Intitulé affiché : nom du modèle figé à l'enregistrement, ou texte libre
  /// (« Repos », « Course »). Garde un sens même sans modèle.
  label      String
  /// Jour de repos : ni modèle, ni séance attendue.
  isRest     Boolean @default(false)

  program  Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  template WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([programId, weekNumber, dayOfWeek])
  @@index([templateId])
}
