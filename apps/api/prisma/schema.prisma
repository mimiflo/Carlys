// Schéma Prisma de Carlys.
//
// Introduit par tranches verticales :
//   - Étape 2 : identité et authentification.
//   - Étape 3 (actuelle) : catalogue d'exercices.
//   - Étape 4 : séances (WorkoutSession, WorkoutSet, …)
// Le modèle de données cible complet est documenté dans docs/database/schema.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Identité ────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  /// Normalisé en minuscules par la couche application avant écriture.
  email           String     @unique
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  /// Suppression logique : le compte est désactivé, purge différée.
  deletedAt       DateTime?

  profile            UserProfile?
  credential         UserCredential?
  sessions           UserSession[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  externalIdentities ExternalIdentity[]
  auditLogs          AuditLog[]
  workoutTemplates   WorkoutTemplate[]
  programs           Program[]
  workoutSessions    WorkoutSession[]
  personalRecords    PersonalRecord[]
  bodyMetrics        BodyMetric[]
  subscriptions      Subscription[]
  entitlements       UserEntitlement[]
  coachConversations CoachConversation[]

  mealEntries              MealEntry[]
  quizAnswers              QuizAnswer[]
  communityPreference      CommunityPreference?
  friendshipsSent          Friendship[]             @relation("FriendshipsSent")
  friendshipsReceived      Friendship[]             @relation("FriendshipsReceived")
  encouragementsSent       Encouragement[]          @relation("EncouragementsSent")
  encouragementsReceived   Encouragement[]          @relation("EncouragementsReceived")
  challengeParticipations  ChallengeParticipation[]
}

/// Sexe biologique — nécessaire aux formules métaboliques (Mifflin-St Jeor).
enum BiologicalSex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum NutritionGoal {
  LOSE_WEIGHT
  MAINTAIN
  GAIN_MUSCLE
}

model UserProfile {
  userId      String   @id @db.Uuid
  displayName String
  locale      String   @default("fr")
  timezone    String   @default("Europe/Paris")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── Profil métabolique (Étape nutrition) — tous facultatifs, le rapport
  // liste les champs manquants ; le poids vient des mesures corporelles.
  sex           BiologicalSex?
  birthDate     DateTime?
  heightCm      Decimal?       @db.Decimal(4, 1)
  activityLevel ActivityLevel?
  nutritionGoal NutritionGoal?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserCredential {
  userId       String   @id @db.Uuid
  /// Hash Argon2id — jamais le mot de passe, jamais loggé, jamais retourné.
  passwordHash String
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Connexion via fournisseur externe (Apple, Google) — endpoints à venir,
/// le modèle fixe dès maintenant la contrainte d'unicité.
enum ExternalIdentityProvider {
  APPLE
  GOOGLE
}

model ExternalIdentity {
  id        String                   @id @default(uuid()) @db.Uuid
  userId    String                   @db.Uuid
  provider  ExternalIdentityProvider
  /// Identifiant stable du compte chez le fournisseur (claim `sub`).
  subject   String
  email     String?
  createdAt DateTime                 @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

// ─────────────────────────── Sessions & tokens ───────────────────────────

/// Session par appareil. L'access token JWT référence la session (claim sid) ;
/// la révoquer invalide immédiatement les requêtes authentifiées.
model UserSession {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  deviceName     String?
  devicePlatform String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())
  /// Expiration glissante : repoussée à chaque rotation du refresh token.
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

enum RefreshTokenStatus {
  ACTIVE
  ROTATED
  REVOKED
}

/// Jeton opaque à usage unique (hash SHA-256 en base). Présenter un jeton
/// ROTATED ou REVOKED = réutilisation détectée → révocation de la session.
model RefreshToken {
  id        String             @id @default(uuid()) @db.Uuid
  sessionId String             @db.Uuid
  tokenHash String             @unique
  status    RefreshTokenStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  expiresAt DateTime
  rotatedAt DateTime?

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// ─────────────────────── Vérifications par e-mail ────────────────────────

model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ────────────────────────────── Audit ────────────────────────────────────

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

/// Journal APPEND-ONLY des événements de sécurité et des actions sensibles.
/// Alimenté dès l'Étape 2 ; enrichi et consulté par l'admin à l'Étape 7.
/// Volontairement sans clé étrangère vers les ressources auditées : le
/// journal survit à leur suppression (référence logique resourceType/Id).
model AuditLog {
  id           String         @id @default(uuid()) @db.Uuid
  actorType    AuditActorType @default(USER)
  userId       String?        @db.Uuid
  adminUserId  String?        @db.Uuid
  /// Ex. auth.login, auth.refresh_reuse_detected, admin.user_suspended…
  action       String
  resourceType String?
  resourceId   String?
  /// Corrélation avec les logs Pino et l'en-tête x-request-id.
  requestId    String?
  ipAddress    String?
  userAgent    String?
  /// Contexte non sensible uniquement — jamais de mot de passe ni de jeton.
  metadata     Json?
  createdAt    DateTime       @default(now())

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([resourceType, resourceId, createdAt])
}

// ───────────────────── Catalogue d'exercices (Étape 3) ─────────────────────

enum ExerciseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ExerciseType {
  STRENGTH
  CARDIO
  MOBILITY
  STRETCHING
}

enum ExerciseMuscleRole {
  PRIMARY
  SECONDARY
}

model MuscleGroup {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exerciseLinks ExerciseMuscle[]
}

model Equipment {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exerciseLinks ExerciseEquipment[]
}

/// Nature d'un média. La photo d'exercice et le maillage 3D suivent le MÊME
/// chemin — dépôt depuis l'admin, stockage objet, URL servie à l'application —
/// et ne se distinguent que par ce champ.
enum MediaKind {
  IMAGE
  MESH_3D
  VIDEO
}

/// Fichier déposé depuis l'administration et servi par le stockage objet.
///
/// Aucun média n'entre dans l'application par un autre chemin : ni asset
/// embarqué, ni URL écrite à la main. C'est ce qui permet d'ajouter une photo
/// ou un maillage sans publier une nouvelle version de l'app.
model MediaAsset {
  /// Fourni par l'administration : un dépôt rejoué ne crée pas de doublon.
  id           String    @id @db.Uuid
  kind         MediaKind
  /// Clé dans le bucket. Unique : deux médias ne partagent jamais un objet.
  storageKey   String    @unique
  mimeType     String
  byteSize     Int
  /// Images et vidéos seulement — un maillage n'a pas de dimensions en pixels.
  width        Int?
  height       Int?
  /// SHA-256 du contenu : reconnaître un fichier déjà déposé.
  checksum     String
  originalName String
  /// Administrateur ayant déposé le fichier. Conservé même s'il part.
  uploadedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// Suppression logique : l'objet reste en stockage tant qu'il est référencé.
  deletedAt    DateTime?

  uploadedBy     AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  exerciseImages Exercise[] @relation("ExerciseImage")
  exerciseMeshes Exercise[] @relation("ExerciseMesh")

  @@index([kind, createdAt])
  @@index([checksum])
}

model Exercise {
  id           String             @id @default(uuid()) @db.Uuid
  slug         String             @unique
  name         String
  description  String
  /// Étapes d'exécution, dans l'ordre.
  instructions String[]
  difficulty   ExerciseDifficulty
  type         ExerciseType
  /// Réservé aux abonnés — le droit effectif sera décidé côté serveur (Étape 6).
  isPremium    Boolean            @default(false)
  /// Un exercice non publié n'apparaît jamais dans le catalogue.
  isPublished  Boolean            @default(true)
  /// Retiré du catalogue depuis l'administration.
  ///
  /// SUPPRESSION DOUCE, et non `DELETE` : un exercice est cité par des séries
  /// déjà réalisées, des records et des modèles de séance. Le supprimer
  /// vraiment effacerait — ou trouerait — l'historique de gens qui n'ont rien
  /// demandé. La suppression force aussi `isPublished` à faux : tout le reste
  /// du code filtre déjà sur ce drapeau, l'exercice disparaît donc partout
  /// sans qu'aucune autre requête n'ait à connaître ce champ.
  deletedAt    DateTime?
  tags         String[]
  /// Photographie du mouvement, déposée depuis l'administration.
  imageId      String?            @db.Uuid
  /// Maillage 3D du mouvement (à venir) — même pipeline que la photo.
  meshId       String?            @db.Uuid
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  /// `SetNull` et non `Cascade` : supprimer un média ne supprime jamais un
  /// exercice — il le laisse simplement sans photo.
  image              MediaAsset?                @relation("ExerciseImage", fields: [imageId], references: [id], onDelete: SetNull)
  mesh               MediaAsset?                @relation("ExerciseMesh", fields: [meshId], references: [id], onDelete: SetNull)
  muscles            ExerciseMuscle[]
  equipment          ExerciseEquipment[]
  workoutSets        WorkoutSet[]
  templateExercises  WorkoutTemplateExercise[]
  sessionPlanItems   WorkoutSessionPlanItem[]
  personalRecords    PersonalRecord[]
  coachProposalItems CoachSessionProposalItem[]

  @@index([isPublished, name])
  @@index([deletedAt])
}

/// Groupes musculaires travaillés — exactement un rôle PRIMARY par exercice
/// (garanti par la couche application et le seed).
model ExerciseMuscle {
  exerciseId    String             @db.Uuid
  muscleGroupId String             @db.Uuid
  role          ExerciseMuscleRole

  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroup MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleGroupId])
  @@index([muscleGroupId])
}

model ExerciseEquipment {
  exerciseId  String @db.Uuid
  equipmentId String @db.Uuid

  exercise  Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([exerciseId, equipmentId])
  @@index([equipmentId])
}

// ─────────────────────────── Séances (Étape 4) ─────────────────────────────

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum WorkoutSetKind {
  WARMUP
  NORMAL
  DROP
}

/// Séance réelle. L'id est un UUID généré SUR L'APPAREIL (offline-first) :
/// la création est idempotente, rejouer la requête ne duplique rien.
model WorkoutSession {
  id              String               @id @db.Uuid
  userId          String               @db.Uuid
  name            String?
  notes           String?
  status          WorkoutSessionStatus @default(IN_PROGRESS)
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  /// Modèle lancé, s'il y en a un. SetNull : une purge physique du modèle
  /// n'efface jamais la séance.
  templateId   String? @db.Uuid
  /// Nom du modèle AU MOMENT DU LANCEMENT — dénormalisé, immuable :
  /// l'historique reste lisible même modèle supprimé ou renommé.
  templateName String?

  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template        WorkoutTemplate?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sets            WorkoutSet[]
  planItems       WorkoutSessionPlanItem[]
  personalRecords PersonalRecord[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([templateId])
}

/// Série PRÉVUE d'une séance : copie APLATIE du modèle au lancement.
///
/// Écrite en une fois avec la séance, elle rend la reprise MULTI-APPAREIL
/// possible : sans elle, un téléphone qui reprend une séance commencée
/// ailleurs voit les séries déjà faites mais plus aucune cible.
///
/// C'est une copie, pas un lien vivant : renommer ou supprimer le modèle
/// ensuite ne touche jamais une séance déjà lancée.
model WorkoutSessionPlanItem {
  id        String @id @db.Uuid
  sessionId String @db.Uuid

  /// Rang de l'exercice dans la séance, à partir de 0.
  exercisePosition Int
  exerciseId       String?        @db.Uuid
  /// Dénormalisé : le plan survit aux évolutions du catalogue.
  exerciseName     String
  /// Rang de la série DANS l'exercice, à partir de 0.
  setPosition      Int
  kind             WorkoutSetKind @default(NORMAL)
  targetReps       Int?
  targetWeightKg   Decimal?       @db.Decimal(6, 2)
  restSeconds      Int?

  /// Série qui a honoré cette prévision. VOLONTAIREMENT sans clé étrangère :
  /// hors ligne, la série peut encore être dans la file d'envoi de l'appareil
  /// quand l'appariement remonte. Une contrainte ferait échouer l'opération
  /// en 4xx, donc la perdrait, alors qu'un identifiant orphelin est sans
  /// conséquence — l'écran n'affiche que la présence de l'appariement.
  doneSetId String? @db.Uuid
  /// Prévision explicitement passée par l'utilisateur.
  skipped   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise?      @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@unique([sessionId, exercisePosition, setPosition])
  @@index([sessionId])
  @@index([exerciseId])
}

/// Série effectuée. Id généré sur l'appareil, écriture en upsert (rejouable).
/// exerciseName est dénormalisé : l'historique survit au catalogue.
model WorkoutSet {
  id              String         @id @db.Uuid
  sessionId       String         @db.Uuid
  exerciseId      String?        @db.Uuid
  exerciseName    String
  position        Int
  kind            WorkoutSetKind @default(NORMAL)
  reps            Int?
  weightKg        Decimal?       @db.Decimal(6, 2)
  durationSeconds Int?
  distanceMeters  Int?
  rpe             Int?
  restSeconds     Int?
  completedAt     DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  /// Cible AFFICHÉE quand l'utilisateur a validé cette série (null hors modèle).
  /// Fait historique : jamais modifiable après coup (PATCH ne les accepte pas).
  plannedReps     Int?
  plannedWeightKg Decimal? @db.Decimal(6, 2)

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise?      @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([sessionId, position])
}

// ───────────────────────── Modèles de séance ──────────────────────────────
//
// Documents PRESCRIPTIFS (ce qui est prévu), distincts des séances réalisées.
// Au lancement, le modèle est COPIÉ dans la séance : il n'y a aucun lien
// vivant, modifier un modèle ne réécrit jamais une séance passée.

/// Modèle de séance : ce que l'utilisateur a PRÉVU de faire, réutilisable.
/// L'id est un UUID généré SUR L'APPAREIL — l'écriture est rejouable.
model WorkoutTemplate {
  id                       String    @id @db.Uuid
  userId                   String    @db.Uuid
  name                     String
  notes                    String?
  /// Saisie facultative de l'utilisateur — JAMAIS calculée par le serveur.
  estimatedDurationMinutes Int?
  /// Dernier lancement : posé à la création d'une séance qui référence ce modèle.
  lastUsedAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises      WorkoutTemplateExercise[]
  sessions       WorkoutSession[]
  coachProposals CoachSessionProposal[]
  programDays    ProgramDay[]

  @@index([userId, updatedAt(sort: Desc)])
}

/// Ligne d'exercice prescrite dans un modèle, ordonnée.
/// exerciseName est dénormalisé : le modèle survit au catalogue.
model WorkoutTemplateExercise {
  id           String  @id @db.Uuid
  templateId   String  @db.Uuid
  exerciseId   String? @db.Uuid
  exerciseName String
  /// Entier contigu à partir de 0, dérivé de l'ordre du tableau reçu.
  /// L'unicité tient parce que le contenu est TOUJOURS réécrit intégralement.
  position     Int
  notes        String?

  template WorkoutTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise Exercise?            @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  sets     WorkoutTemplateSet[]

  @@unique([templateId, position])
  @@index([exerciseId])
}

/// Série prévue d'une ligne d'exercice. Cibles, pas mesures :
/// ce qui sera réellement fait vit dans WorkoutSet.
model WorkoutTemplateSet {
  id                 String         @id @db.Uuid
  templateExerciseId String         @db.Uuid
  position           Int
  kind               WorkoutSetKind @default(NORMAL)
  targetReps         Int?
  targetWeightKg     Decimal?       @db.Decimal(6, 2)
  restSeconds        Int?

  templateExercise WorkoutTemplateExercise @relation(fields: [templateExerciseId], references: [id], onDelete: Cascade)

  @@unique([templateExerciseId, position])
}

// ────────────────────────── Progression (Étape 5) ──────────────────────────

enum PersonalRecordType {
  MAX_WEIGHT
  MAX_REPS
  MAX_SET_VOLUME
}

/// Records personnels, recalculés à la clôture de chaque séance.
/// Clé par exerciseName (dénormalisé) : les records survivent au catalogue.
model PersonalRecord {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @db.Uuid
  exerciseId   String?            @db.Uuid
  exerciseName String
  recordType   PersonalRecordType
  /// kg, répétitions ou kg de volume selon recordType.
  value        Decimal            @db.Decimal(10, 2)
  reps         Int?
  weightKg     Decimal?           @db.Decimal(6, 2)
  achievedAt   DateTime
  sessionId    String?            @db.Uuid
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise?       @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  session  WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([userId, exerciseName, recordType])
  @@index([userId, achievedAt])
}

enum BodyMetricType {
  WEIGHT_KG
  BODY_FAT_PERCENT
}

/// Mesure corporelle. Id généré côté client (création idempotente).
model BodyMetric {
  id         String         @id @db.Uuid
  userId     String         @db.Uuid
  metricType BodyMetricType
  value      Decimal        @db.Decimal(6, 2)
  measuredAt DateTime
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, metricType, measuredAt])
}

// ─────────────────────────── Abonnements (Étape 6) ───────────────────────────

enum PaymentProvider {
  STRIPE
  REVENUECAT
  APP_STORE
  PLAY_STORE
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

/// Plan commercial interne, indépendant des fournisseurs de paiement.
model SubscriptionPlan {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products      SubscriptionProduct[]
  subscriptions Subscription[]
}

/// Correspondance plan interne ↔ produit chez un fournisseur.
model SubscriptionProduct {
  id                String          @id @default(uuid()) @db.Uuid
  planId            String          @db.Uuid
  provider          PaymentProvider
  externalProductId String
  billingPeriod     BillingPeriod
  createdAt         DateTime        @default(now())

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([provider, externalProductId])
}

/// État courant de l'abonnement, projeté depuis les événements fournisseurs.
model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @db.Uuid
  planId                 String             @db.Uuid
  provider               PaymentProvider
  externalSubscriptionId String
  status                 SubscriptionStatus
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  trialEndsAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan    @relation(fields: [planId], references: [id])
  events       SubscriptionEvent[]
  entitlements UserEntitlement[]

  @@unique([provider, externalSubscriptionId])
  @@index([userId, status])
}

/// Journal APPEND-ONLY des webhooks reçus — la garantie d'idempotence :
/// un événement (provider, externalEventId) n'est traité qu'une seule fois.
model SubscriptionEvent {
  id              String          @id @default(uuid()) @db.Uuid
  provider        PaymentProvider
  externalEventId String
  eventType       String
  /// JSON brut du webhook (usage légitime du JSON : trace de traitement).
  payload         Json
  receivedAt      DateTime        @default(now())
  processedAt     DateTime?
  processingError String?
  subscriptionId  String?         @db.Uuid

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([receivedAt])
}

/// Source de vérité SERVEUR des droits effectifs, matérialisée pour une
/// lecture O(1). Peut aussi être accordé manuellement (Étape 7, audité).
model UserEntitlement {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  entitlementKey       String
  isActive             Boolean   @default(false)
  expiresAt            DateTime?
  sourceSubscriptionId String?   @db.Uuid
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceSubscription Subscription? @relation(fields: [sourceSubscriptionId], references: [id], onDelete: SetNull)

  @@unique([userId, entitlementKey])
  @@index([userId, isActive])
}

// ────────────────────────── Administration (Étape 7) ──────────────────────────

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

/// Compte d'administration — JAMAIS confondu avec User (comptes mobiles).
model AdminUser {
  id           String          @id @default(uuid()) @db.Uuid
  /// Normalisé en minuscules par la couche application avant écriture.
  email        String          @unique
  /// Hash Argon2id — jamais le mot de passe, jamais loggé, jamais retourné.
  passwordHash String
  displayName  String
  status       AdminUserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  roles       AdminUserRole[]
  auditLogs   AuditLog[]
  /// Médias déposés par cet administrateur.
  mediaAssets MediaAsset[]
}

/// Rôle nommé (ex. superadmin, support, content-manager).
model AdminRole {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  name        String
  description String?

  users       AdminUserRole[]
  permissions AdminRolePermission[]
}

/// Permission granulaire, seedée par le code (source de vérité de la liste).
model AdminPermission {
  id       String @id @default(uuid()) @db.Uuid
  resource String
  action   String

  roles AdminRolePermission[]

  @@unique([resource, action])
}

model AdminUserRole {
  adminUserId String @db.Uuid
  roleId      String @db.Uuid

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
}

model AdminRolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ─────────────────────────────── Coach IA ─────────────────────────────────
//
// L'IA PROPOSE, l'application EXÉCUTE. Le coach n'a aucun outil d'écriture :
// sa seule sortie structurée est une proposition de séance, que l'utilisateur
// accepte explicitement. La création passe ensuite par le chemin de séance
// existant — idempotent, hors ligne, rejouable.

enum CoachMessageRole {
  USER
  ASSISTANT
}

/// Fil de discussion. L'id vient de l'appareil : le premier message peut être
/// composé avant que le serveur n'ait jamais entendu parler du fil.
model CoachConversation {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  /// Résumé court du fil, écrit par le coach au premier échange.
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CoachMessage[]

  @@index([userId, updatedAt(sort: Desc)])
}

model CoachMessage {
  id             String           @id @db.Uuid
  conversationId String           @db.Uuid
  role           CoachMessageRole
  content        String
  /// Jetons consommés par CE message (rôle ASSISTANT uniquement) —
  /// observabilité du coût, jamais de la facturation.
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime         @default(now())

  conversation CoachConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  proposal     CoachSessionProposal?

  @@index([conversationId, createdAt])
}

/// Séance proposée par le coach. Tant qu'elle n'est pas acceptée, ce n'est
/// qu'un document : elle ne compte NI dans l'historique, NI dans les
/// statistiques, NI dans les records.
model CoachSessionProposal {
  id                String   @id @db.Uuid
  messageId         String   @unique @db.Uuid
  name              String
  /// Durée annoncée à l'utilisateur, en minutes.
  estimatedMinutes  Int
  /// Modèle dont la proposition est dérivée, s'il y en a un.
  sourceTemplateId  String?  @db.Uuid
  /// Séance réellement lancée depuis cette proposition. Posé par l'application
  /// à l'acceptation ; sert à mesurer ce que le coach fait vraiment démarrer.
  /// VOLONTAIREMENT sans clé étrangère : la séance naît sur l'appareil et peut
  /// être encore dans la file d'envoi quand l'acceptation remonte.
  acceptedSessionId String?  @db.Uuid
  createdAt         DateTime @default(now())

  message  CoachMessage               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  template WorkoutTemplate?           @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  items    CoachSessionProposalItem[]
}

/// Série proposée — MÊME FORME que `WorkoutSessionPlanItem`, volontairement :
/// l'acceptation est alors une copie, pas une traduction.
model CoachSessionProposalItem {
  id         String @id @db.Uuid
  proposalId String @db.Uuid

  exercisePosition Int
  /// Clé étrangère FERME, contrairement à l'historique où un exercice supprimé
  /// ne doit jamais effacer une séance passée. Une proposition n'est pas de
  /// l'historique : si l'exercice n'existe pas, elle n'a aucune raison
  /// d'exister. C'est la base qui rend l'invention impossible, pas le code.
  exerciseId       String         @db.Uuid
  /// Dénormalisé comme partout ailleurs : la proposition reste lisible même
  /// si le catalogue évolue entre la proposition et sa lecture.
  exerciseName     String
  setPosition      Int
  kind             WorkoutSetKind @default(NORMAL)
  targetReps       Int?
  targetWeightKg   Decimal?       @db.Decimal(6, 2)
  restSeconds      Int?

  proposal CoachSessionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  exercise Exercise             @relation(fields: [exerciseId], references: [id])

  @@unique([proposalId, exercisePosition, setPosition])
  @@index([proposalId])
  @@index([exerciseId])
}

// ─────────────────────────── Journal alimentaire ──────────────────────────

/// Entrée du journal alimentaire : ce que l'utilisateur dit avoir mangé.
///
/// C'est la moitié RÉELLE du « 654 / 2 100 » de l'accueil : le consommé vient
/// d'ici, l'objectif du profil métabolique. Id généré SUR L'APPAREIL
/// (création idempotente, rejouable) ; `eatenAt` est un INSTANT UTC — le
/// découpage en journées appartient au client, qui connaît son fuseau.
model MealEntry {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  name      String
  kcal      Int
  proteinG  Int?
  eatenAt   DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eatenAt])
}

// ────────────────────────────── Communauté ────────────────────────────────
//
// La séparation public/privé est une décision SERVEUR : ce que voit un ami
// est décidé ici, jamais par le client. Le nom d'affichage est la seule
// donnée toujours visible ; la progression (série, séances de la semaine)
// n'est servie que si son propriétaire la partage.

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// Préférence communautaire de l'utilisateur. Table à part de UserProfile :
/// le partage de progression est un choix communautaire, pas une donnée
/// d'identité — et son absence vaut « partagé » (défaut confirmé au premier
/// passage sur l'écran Communauté).
model CommunityPreference {
  userId         String   @id @db.Uuid
  sharesProgress Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Lien d'amitié. UNE ligne par paire, créée PENDING par la demande ; la
/// direction (qui a demandé) est conservée pour l'affichage des demandes.
/// L'unicité de la paire dans LES DEUX SENS est imposée par le service :
/// une contrainte symétrique n'est pas exprimable en Prisma.
model Friendship {
  id          String              @id @default(uuid()) @db.Uuid
  requesterId String              @db.Uuid
  addresseeId String              @db.Uuid
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

/// Mot envoyé à un ami. Le nom de l'expéditeur est lu au moment de servir le
/// fil (pas dénormalisé) : un fil social montre le nom COURANT des gens.
model Encouragement {
  id          String   @id @default(uuid()) @db.Uuid
  senderId    String   @db.Uuid
  recipientId String   @db.Uuid
  message     String
  createdAt   DateTime @default(now())

  sender    User @relation("EncouragementsSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("EncouragementsReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt(sort: Desc)])
}

enum ChallengeKind {
  SPORT
  CULTURE
}

/// Défi COLLECTIF, créé par l'équipe (seed puis admin) — jamais par un
/// utilisateur. La progression est la somme des contributions rapportée à
/// l'objectif : la barre raconte l'effort commun.
model CommunityChallenge {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  kind        ChallengeKind
  title       String
  description String
  /// Objectif collectif (séances, répétitions, bonnes réponses…).
  target      Int
  startsAt    DateTime      @default(now())
  endsAt      DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  participations ChallengeParticipation[]

  @@index([endsAt])
}

/// Réponse à une question de l'Academy — la source des défis CULTURE.
///
/// Une ligne par (utilisateur, leçon, jour local) : la création est
/// idempotente, rejouer la même réponse ne compte jamais deux fois.
/// `answeredOn` est le jour LOCAL de l'appareil (YYYY-MM-DD) — le serveur ne
/// découpe pas les journées, même principe que le journal alimentaire.
model QuizAnswer {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  /// Identifiant de la leçon du pack embarqué (contenu éditorial).
  lessonId   String
  answeredOn String
  correct    Boolean
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, answeredOn])
  @@index([userId, createdAt])
}

model ChallengeParticipation {
  challengeId  String   @db.Uuid
  userId       String   @db.Uuid
  /// Contribution individuelle à l'objectif collectif. Pour les défis SPORT,
  /// incrémentée à la clôture de chaque séance pendant la fenêtre du défi.
  contribution Int      @default(0)
  joinedAt     DateTime @default(now())

  challenge CommunityChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([challengeId, userId])
  @@index([userId])
}

/// Programme multi-semaines : un plan d'entraînement dans le temps.
///
/// Un programme n'est PAS un modèle de séance : le modèle décrit le contenu
/// d'une séance, le programme décrit à quel moment la faire. Il ne duplique
/// donc aucun exercice — chaque jour pointe vers un modèle existant, ou
/// n'annonce qu'un intitulé (repos, activité libre).
///
/// Comme le modèle de séance : identifiant fourni par l'appareil (création
/// hors ligne), contenu TOUJOURS réécrit intégralement, suppression logique.
model Program {
  id          String    @id @db.Uuid
  userId      String    @db.Uuid
  name        String
  description String?
  /// Nombre de semaines du plan (1 à 52). Les jours au-delà sont refusés.
  weeksCount  Int
  /// Programme suivi en ce moment. UN SEUL par utilisateur : deux programmes
  /// « en cours » n'ont aucun sens, l'application ne saurait lequel afficher.
  /// PostgreSQL ne peut pas l'exprimer ici (il faudrait un index unique
  /// PARTIEL, hors du vocabulaire Prisma), c'est donc le service qui l'impose,
  /// en désactivant les autres dans la même transaction.
  isActive    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  days ProgramDay[]

  @@index([userId, updatedAt(sort: Desc)])
}

/// Une case du calendrier du programme : semaine N, jour J.
model ProgramDay {
  id         String  @id @db.Uuid
  programId  String  @db.Uuid
  /// 1 à `weeksCount`.
  weekNumber Int
  /// 1 (lundi) à 7 (dimanche).
  dayOfWeek  Int
  /// Modèle à jouer ce jour-là. `SetNull` : supprimer un modèle vide la case,
  /// il ne fait jamais disparaître le programme.
  templateId String? @db.Uuid
  /// Intitulé affiché : nom du modèle figé à l'enregistrement, ou texte libre
  /// (« Repos », « Course »). Garde un sens même sans modèle.
  label      String
  /// Jour de repos : ni modèle, ni séance attendue.
  isRest     Boolean @default(false)

  program  Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  template WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([programId, weekNumber, dayOfWeek])
  @@index([templateId])
}
