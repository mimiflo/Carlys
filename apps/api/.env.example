# Configuration de l'API Carlys — valeurs FACTICES pour le développement local.
# Copier vers apps/api/.env puis adapter. Ne jamais commiter de vrais secrets.

NODE_ENV=development
PORT=3000

# Correspond aux services du docker-compose.yml racine.
DATABASE_URL=postgresql://carlys:carlys_dev_password@localhost:5432/carlys_dev
REDIS_URL=redis://localhost:6379

# Origines autorisées (séparées par des virgules). 3001 = admin Next.js local.
CORS_ORIGINS=http://localhost:3001

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Swagger est activé par défaut hors production ; forcer ici si besoin.
# SWAGGER_ENABLED=true

# Requis uniquement pour exposer /metrics en production (min. 16 caractères).
# METRICS_TOKEN=jeton-factice-a-remplacer

# ── Authentification ────────────────────────────────────────────────────────
# OBLIGATOIRE (>= 32 caractères). Valeur factice de développement — générer un
# vrai secret par environnement : openssl rand -base64 48
JWT_ACCESS_SECRET=secret-jwt-de-developpement-a-remplacer-absolument
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=carlys-api
JWT_AUDIENCE=carlys-mobile
REFRESH_TOKEN_TTL_DAYS=30
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Paramètres Argon2id (défauts OWASP)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# ── Abonnements (Étape 6) — valeurs FACTICES, jamais de vrai secret ici ─────
# Tant qu'un secret n'est pas configuré, l'endpoint de webhook répond 503.
STRIPE_WEBHOOK_SECRET=whsec_valeur_factice_de_developpement
REVENUECAT_WEBHOOK_SECRET=rcsec_valeur_factice_de_developpement

# ── Coach IA — valeur FACTICE, jamais de vraie clé ici ──────────────────────
# Sans clé, le module coach répond 503 : l'API démarre quand même.
ANTHROPIC_API_KEY=sk-ant-valeur-factice-de-developpement
COACH_MODEL=claude-opus-5
COACH_DAILY_MESSAGE_LIMIT=30
COACH_ENABLED=true

# ── E-mails (Mailpit local : interface sur http://localhost:8025) ───────────
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Carlys <no-reply@carlys.local>"
PUBLIC_APP_URL=http://localhost:3000
