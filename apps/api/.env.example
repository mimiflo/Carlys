# Configuration de l'API Carlys — valeurs FACTICES pour le développement local.
# Copier vers apps/api/.env puis adapter. Ne jamais commiter de vrais secrets.

NODE_ENV=development
PORT=3000

# Correspond aux services du docker-compose.yml racine.
DATABASE_URL=postgresql://carlys:carlys_dev_password@localhost:5432/carlys_dev
REDIS_URL=redis://localhost:6379

# Origines autorisées (séparées par des virgules). 3001 = admin Next.js local.
CORS_ORIGINS=http://localhost:3001

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Swagger est activé par défaut hors production ; forcer ici si besoin.
# SWAGGER_ENABLED=true

# Requis uniquement pour exposer /metrics en production (min. 16 caractères).
# METRICS_TOKEN=jeton-factice-a-remplacer

# ── Authentification ────────────────────────────────────────────────────────
# OBLIGATOIRE (>= 32 caractères). Valeur factice de développement — générer un
# vrai secret par environnement : openssl rand -base64 48
JWT_ACCESS_SECRET=secret-jwt-de-developpement-a-remplacer-absolument
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=carlys-api
JWT_AUDIENCE=carlys-mobile
REFRESH_TOKEN_TTL_DAYS=30
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Paramètres Argon2id (défauts OWASP)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# ── Abonnements (Étape 6) — valeurs FACTICES, jamais de vrai secret ici ─────
# Tant qu'un secret n'est pas configuré, l'endpoint de webhook répond 503.
STRIPE_WEBHOOK_SECRET=whsec_valeur_factice_de_developpement
REVENUECAT_WEBHOOK_SECRET=rcsec_valeur_factice_de_developpement

# Catalogue d'offres servi à l'application. Les prix vivent ICI et jamais
# dans le mobile : un tarif codé dans l'app deviendrait faux le jour où il
# change. Ils doivent refléter les prix Stripe correspondants.
SUBSCRIPTION_CURRENCY=EUR
SUBSCRIPTION_MONTHLY_CENTS=999
SUBSCRIPTION_YEARLY_CENTS=7990
SUBSCRIPTION_TRIAL_DAYS=7

# Paiement Stripe. Sans clé, le catalogue reste lisible et l'achat se
# déclare simplement indisponible — jamais un bouton qui échouerait.
STRIPE_SECRET_KEY=sk_test_valeur_factice_de_developpement
STRIPE_PRICE_MONTHLY=price_factice_mensuel
STRIPE_PRICE_YEARLY=price_factice_annuel

# ── Notifications push (FCM) — jamais de vraie clé ici ──────────────────────
# JSON complet du compte de service Firebase (console Firebase → Paramètres →
# Comptes de service → Générer une clé privée). Sans lui, l'envoi de push est
# simplement inactif : l'API démarre et les jetons s'enregistrent quand même.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"exemple-factice"}

# ── Coach IA — valeur FACTICE, jamais de vraie clé ici ──────────────────────
# Sans clé, le module coach répond 503 : l'API démarre quand même.
ANTHROPIC_API_KEY=sk-ant-valeur-factice-de-developpement
COACH_MODEL=claude-opus-5
COACH_DAILY_MESSAGE_LIMIT=30
COACH_ENABLED=true

# ── Stockage objet (MinIO local, S3 compatible en production) ───────────────
# Valeurs FACTICES de développement, identiques à celles du docker-compose.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=carlys-media
S3_ACCESS_KEY_ID=carlys-dev
S3_SECRET_ACCESS_KEY=carlys-dev-secret
S3_PUBLIC_BASE_URL=http://localhost:9000/carlys-media
S3_FORCE_PATH_STYLE=true
MEDIA_MAX_UPLOAD_BYTES=20971520

# ── E-mails (Mailpit local : interface sur http://localhost:8025) ───────────
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Carlys <no-reply@carlys.local>"
# Base des liens envoyés par e-mail (/verify-email, /reset-password) et des
# retours Stripe (/abonnement/merci, /abonnement). Ces pages sont servies par
# l'application web Next.js (apps/admin, groupe de routes « (public) »),
# JAMAIS par l'API : cette URL doit désigner l'application web, soit
# http://localhost:3001 en local. La valeur ci-dessous (l'API elle-même) est
# l'ancien défaut et ne sert aucune de ces pages.
PUBLIC_APP_URL=http://localhost:3000
