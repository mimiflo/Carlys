# Configuration de l'API Carlys — valeurs FACTICES pour le développement local.
# Copier vers apps/api/.env puis adapter. Ne jamais commiter de vrais secrets.

NODE_ENV=development
PORT=3000

# Correspond aux services du docker-compose.yml racine.
DATABASE_URL=postgresql://carlys:carlys_dev_password@localhost:5432/carlys_dev
REDIS_URL=redis://localhost:6379

# Origines autorisées (séparées par des virgules). 3001 = admin Next.js local.
CORS_ORIGINS=http://localhost:3001

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Nombre de proxys de CONFIANCE devant l'API. 0 en local (l'adresse de la
# socket fait foi). 1 derrière un Nginx unique (voir infrastructure/nginx) :
# l'API lit alors l'adresse du client dans X-Forwarded-For pour la limitation
# de débit, le verrouillage et l'audit. Jamais plus de sauts qu'il n'y en a
# réellement : chaque saut de trop est une adresse que le client peut forger.
TRUST_PROXY_HOPS=0

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Swagger est activé par défaut hors production ; forcer ici si besoin.
# SWAGGER_ENABLED=true

# Requis uniquement pour exposer /metrics en production (min. 16 caractères).
# METRICS_TOKEN=jeton-factice-a-remplacer

# Fenêtre du compte « utilisateurs en ligne » exposé dans /metrics, en
# secondes (60 à 3600). C'est ce compte qui pilote la mise à l'échelle
# automatique sur le serveur : voir docs/deployment/orchestration.md.
# PRESENCE_WINDOW_SECONDS=300

# ── Authentification ────────────────────────────────────────────────────────
# OBLIGATOIRE (>= 32 caractères). Valeur factice de développement — générer un
# vrai secret par environnement : openssl rand -base64 48
JWT_ACCESS_SECRET=secret-jwt-de-developpement-a-remplacer-absolument
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=carlys-api
JWT_AUDIENCE=carlys-mobile
REFRESH_TOKEN_TTL_DAYS=30
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Paramètres Argon2id (défauts OWASP)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# ── Abonnements (Étape 6) — valeurs FACTICES, jamais de vrai secret ici ─────
# Tant qu'un secret n'est pas configuré, l'endpoint de webhook répond 503.
STRIPE_WEBHOOK_SECRET=whsec_valeur_factice_de_developpement
REVENUECAT_WEBHOOK_SECRET=rcsec_valeur_factice_de_developpement

# Catalogue d'offres servi à l'application. Les prix vivent ICI et jamais
# dans le mobile : un tarif codé dans l'app deviendrait faux le jour où il
# change. Ils doivent refléter les prix Stripe correspondants.
SUBSCRIPTION_CURRENCY=EUR
SUBSCRIPTION_MONTHLY_CENTS=999
SUBSCRIPTION_YEARLY_CENTS=7990
SUBSCRIPTION_TRIAL_DAYS=7

# Paiement Stripe. Sans clé, le catalogue reste lisible et l'achat se
# déclare simplement indisponible — jamais un bouton qui échouerait. La
# même clé résilie l'abonnement quand un compte est supprimé ; hors
# production, sans elle, la suppression passe sans résilier (journalisé).
STRIPE_SECRET_KEY=sk_test_valeur_factice_de_developpement
STRIPE_PRICE_MONTHLY=price_factice_mensuel
STRIPE_PRICE_YEARLY=price_factice_annuel

# Produits RevenueCat (magasins). En développement, ceux que le seed projette.
REVENUECAT_PRODUCT_MONTHLY=carlys_premium_monthly
REVENUECAT_PRODUCT_YEARLY=carlys_premium_yearly

# ── Notifications push (FCM) — jamais de vraie clé ici ──────────────────────
# JSON complet du compte de service Firebase (console Firebase → Paramètres →
# Comptes de service → Générer une clé privée). Sans lui, l'envoi de push est
# simplement inactif : l'API démarre et les jetons s'enregistrent quand même.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"exemple-factice"}

# ── Connexion sociale (Apple, Google) ───────────────────────────────────────
# Audiences ACCEPTÉES des jetons d'identité, séparées par des virgules. Ce ne
# sont pas des secrets (le client les porte dans l'application), mais ils sont
# propres à ton projet. Sans elles, POST /auth/social répond 503 pour le
# fournisseur concerné : l'API démarre quand même.
#
# Google : la liste des AUDIENCES acceptées, c'est-à-dire les valeurs que le
# claim `aud` du jeton peut prendre. Ce n'est pas « tous les clients du
# projet » :
#   - client « Web »    : OUI. C'est l'audience sur ANDROID, où le SDK reçoit
#                         ce client en `serverClientId`.
#   - client « iOS »    : OUI, le jour où l'app iOS existe. Là, le SDK émet un
#                         jeton dont l'audience est CE client, pas le « Web ».
#   - client « Android »: NON. Il identifie l'application par son nom de
#                         paquet et l'empreinte de sa clé ; il n'apparaît
#                         JAMAIS en `aud` (au mieux en `azp`, que la
#                         vérification ne lit pas). L'ajouter ici élargit la
#                         liste sans rien permettre de plus.
# Voir docs/deployment/connexion-sociale.md.
# GOOGLE_OAUTH_CLIENT_IDS=000000000000-exemple.apps.googleusercontent.com
# Apple : le bundle ID de l'app iOS (et le Services ID web le cas échéant).
# C'est celui que pose `flutter create --org com.carlys --project-name
# carlys_mobile` (scripts/mobile_platforms.sh), en camelCase côté iOS :
# APPLE_OAUTH_AUDIENCES=com.carlys.carlysMobile

# ── Coach IA — valeur FACTICE, jamais de vraie clé ici ──────────────────────
# Sans COACH_API_BASE_URL ET COACH_MODEL, le module coach répond 503 : l'API
# démarre quand même. Un seul fournisseur : notre modèle, par une API
# compatible OpenAI (Ollama). Pas à pas : docs/deployment/mise-en-route-serveur.md.
# Sur le serveur (choix du 29/09/2026, ADR 0011) : Qwen3-4B par Ollama.
# En local (sur la boucle locale seulement : l'API d'Ollama n'a pas de mot
# de passe) :
#   docker run -d --name ollama -p 127.0.0.1:11434:11434 -v ollama:/root/.ollama ollama/ollama:0.34.4
#   docker exec ollama ollama pull qwen3:4b-instruct-2507-q4_K_M
# COACH_API_BASE_URL=http://localhost:11434/v1
# COACH_MODEL=qwen3:4b-instruct-2507-q4_K_M
COACH_DAILY_MESSAGE_LIMIT=30
COACH_ENABLED=true
# Passerelle du coach (ADR 0013) : file, limites, workers. Défauts sûrs pour
# une machine ; liste complète dans docs/product/coach-ia.md.
# COACH_MAX_CONCURRENT_REQUESTS=1
# COACH_QUEUE_MAX_SIZE=20
# COACH_MESSAGES_PER_MINUTE=6
# COACH_WORKER_URLS=http://localhost:11434/v1

# ── Stockage objet (MinIO local, S3 compatible en production) ───────────────
# Valeurs FACTICES de développement, identiques à celles du docker-compose.
# En production (NODE_ENV=production), le démarrage est REFUSÉ tant que
# S3_*, SMTP_HOST, EMAIL_FROM, PUBLIC_APP_URL et CORS_ORIGINS gardent une
# valeur de développement (localhost, carlys-dev*, http://) :
# voir docs/security/reverse-proxy.md.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=carlys-media
# Bucket PRIVÉ des photos de repas (données personnelles) : jamais lisible
# sans jeton, jamais le même que S3_BUCKET (refusé au démarrage). Créé par
# minio-init dans docker-compose.yml.
S3_PRIVATE_BUCKET=carlys-private
S3_ACCESS_KEY_ID=carlys-dev
S3_SECRET_ACCESS_KEY=carlys-dev-secret
S3_PUBLIC_BASE_URL=http://localhost:9000/carlys-media
S3_FORCE_PATH_STYLE=true
MEDIA_MAX_UPLOAD_BYTES=20971520

# ── E-mails (Mailpit local : interface sur http://localhost:8025) ───────────
SMTP_HOST=localhost
SMTP_PORT=1025
# Vides en développement : Mailpit n'authentifie rien. Un relais commercial,
# lui, les exige — sans quoi rien ne part et aucun journal ne le dit.
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="Carlys <no-reply@carlys.local>"
# Base des liens envoyés par e-mail (/verify-email, /reset-password) et des
# retours Stripe (/abonnement/merci, /abonnement). Ces pages sont servies par
# l'application web Next.js (apps/admin, groupe de routes « (public) »),
# JAMAIS par l'API : cette URL désigne l'application web (port 3001 en local).
PUBLIC_APP_URL=http://localhost:3001
