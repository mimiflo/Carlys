{
  "rootDir": "..",
  "maxWorkers": 1,
  "projects": [
    {
      "displayName": "e2e",
      "rootDir": "./test",
      "moduleFileExtensions": ["js", "json", "ts"],
      "testEnvironment": "node",
      "testRegex": "\\.e2e-spec\\.ts$",
      "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
      },
      "setupFilesAfterEnv": ["<rootDir>/setup-e2e.ts"]
    },
    {
      "displayName": "sans-infra",
      "rootDir": "./test",
      "moduleFileExtensions": ["js", "json", "ts"],
      "testEnvironment": "node",
      "testRegex": "\\.sans-infra-spec\\.ts$",
      "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
      }
    }
  ]
}
