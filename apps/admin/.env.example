# Configuration de l'admin Carlys — valeurs FACTICES pour le développement local.
# Copier vers apps/admin/.env.local puis adapter.

# Base de l'API (sans /api/v1) — inlinée au build (NEXT_PUBLIC_*).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Image de production seulement (posée par apps/admin/Dockerfile, jamais en local) :
# `forbid` fait échouer `next build` tant que docs/legal porte un marqueur [À COMPLÉTER : …].
# LEGAL_PLACEHOLDERS=forbid
