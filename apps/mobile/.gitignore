# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.metadata

# Code généré
**/*.g.dart
**/*.freezed.dart
**/*.drift.dart

# Plateformes (générées via scripts/bootstrap_mobile.sh) : JAMAIS
# versionnées — l'identité (nom, icône) vit dans launcher/ et
# scripts/android_branding.sh. Les fichiers .iml viennent aussi de
# flutter create.
/android/
/ios/
*.iml
android/local.properties
android/.gradle/
ios/Pods/
ios/.symlinks/
ios/Flutter/ephemeral/
macos/Flutter/ephemeral/
windows/flutter/ephemeral/
linux/flutter/ephemeral/

# Secrets locaux
*.env
.env*
!.env.example

# Configuration Firebase locale (voir config/firebase.example.json). Les
# valeurs client ne sont pas des secrets au sens strict, mais elles restent
# hors du dépôt publié — chacun fournit celles de son projet Firebase.
config/firebase.json
google-services.json
GoogleService-Info.plist
tool/screenshots/goldens/

# Ce que le comparateur de captures écrit quand une image diffère : une
# SORTIE de test, régénérée à chaque passe, jamais une source. 96 de ces
# images (26 Mo) avaient été commitées par erreur le 22 septembre 2026.
tool/screenshots/failures/
