<component name="ProjectRunConfigurationManager">
  <!--
    LE lancement de Carlys : l'application connectée à l'API.
    À démarrer AVANT, dans un terminal à la racine du dépôt :
        docker compose up -d && pnpm dev:api
    10.0.2.2 est l'alias de la MACHINE HÔTE vu depuis l'émulateur ;
    `localhost` y désignerait l'émulateur lui-même, et l'API resterait
    injoignable. Sur un téléphone branché en USB, remplacer par l'IP du
    poste sur le réseau local.
  -->
  <configuration default="false" name="Carlys" type="FlutterRunConfigurationType" factoryName="Flutter">
    <option name="additionalArgs" value="--dart-define=CARLYS_FLAVOR=development --dart-define=CARLYS_API_BASE_URL=http://10.0.2.2:3000" />
    <option name="filePath" value="$PROJECT_DIR$/lib/main.dart" />
    <method v="2" />
  </configuration>
</component>
