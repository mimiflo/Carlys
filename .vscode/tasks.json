{
  // Tâche accrochée au lancement (`preLaunchTask`) : tout ce dont le
  // lancement a besoin, et seulement si ça manque — remise à niveau,
  // infrastructure Docker, migrations, émulateur. Quand tout est déjà
  // debout, elle coûte quelques secondes.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Préparer Carlys",
      "type": "shell",
      // `bash` explicitement : sous Windows le terminal par défaut est
      // PowerShell, qui ne sait pas exécuter un script shell. Git Bash est
      // installé avec Git et se trouve dans le PATH.
      "command": "bash",
      "args": ["scripts/dev_up.sh"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
