{
  // Lancements Flutter de Carlys — volontairement DEUX choix dans le menu F5 :
  //   1. « Carlys — démo (sans serveur) »  : données intégrées, rien à démarrer.
  //   2. « Carlys — API + émulateur Android » : le vrai mode, API + app ensemble.
  // Les deux configurations marquées hidden sont les briques du composé ; les
  // masquer évite de lancer l'app en mode development SANS l'API, ou l'API
  // sans l'app. Pour un téléphone réel ou le web, voir
  // docs/development/poste-de-travail.md (l'adresse d'API change à chaque cas).
  "version": "0.2.0",
  "configurations": [
    {
      // À ESSAYER EN PREMIER : aucun serveur, aucune base, données intégrées.
      // C'est le mode qui prouve que le poste est bien monté.
      "name": "Carlys — démo (sans serveur)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "apps/mobile",
      "args": ["--dart-define=CARLYS_FLAVOR=demo"]
    },
    {
      // Brique du composé. 10.0.2.2 est l'alias de la MACHINE HÔTE vu depuis
      // l'émulateur : `localhost` y désignerait l'émulateur lui-même.
      "name": "Carlys — app (émulateur, brique du composé)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "apps/mobile",
      "args": [
        "--dart-define=CARLYS_FLAVOR=development",
        "--dart-define=CARLYS_API_BASE_URL=http://10.0.2.2:3000"
      ],
      "presentation": { "hidden": true }
    },
    {
      // Brique du composé. Nécessite l'infra Docker déjà démarrée
      // (docker compose up -d).
      "name": "API NestJS (brique du composé)",
      "request": "launch",
      "type": "node",
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "hidden": true }
    }
  ],
  "compounds": [
    {
      // LE mode de travail réel : l'API et l'app ensemble, déjà câblées.
      "name": "Carlys — API + émulateur Android",
      "configurations": [
        "API NestJS (brique du composé)",
        "Carlys — app (émulateur, brique du composé)"
      ]
    }
  ]
}
