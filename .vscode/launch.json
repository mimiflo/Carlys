{
  // Un SEUL lancement dans le menu F5 : Carlys, l'application connectée à
  // son API — la version qu'on développe et qu'on livre. Le mode démo
  // (données intégrées) existe toujours dans l'application : il sert aux
  // tests, à la galerie de captures et à l'APK de démonstration, mais il
  // n'a plus sa place dans le menu de lancement quotidien.
  //
  // Les deux configurations masquées sont les briques du composé — un
  // composé ne sait pas les inventer. Les cacher évite de lancer l'app en
  // mode development SANS l'API. Pour un téléphone réel ou le web, voir
  // docs/development/poste-de-travail.md (l'adresse d'API change à chaque cas).
  "version": "0.2.0",
  "configurations": [
    {
      // Brique du composé. 10.0.2.2 est l'alias de la MACHINE HÔTE vu depuis
      // l'émulateur : `localhost` y désignerait l'émulateur lui-même.
      "name": "Carlys — app (émulateur, brique du composé)",
      "request": "launch",
      "type": "dart",
      // Démarre l'émulateur et ATTEND qu'il accepte une installation. Sans
      // cette attente, le lancement échouerait sur « no devices found »
      // pendant que la fenêtre de l'émulateur finit de s'ouvrir.
      "preLaunchTask": "Émulateur Android",
      "program": "lib/main.dart",
      "cwd": "apps/mobile",
      "args": [
        "--dart-define=CARLYS_FLAVOR=development",
        "--dart-define=CARLYS_API_BASE_URL=http://10.0.2.2:3000"
      ],
      "presentation": { "hidden": true }
    },
    {
      // Brique du composé. Nécessite l'infra Docker déjà démarrée
      // (docker compose up -d).
      "name": "API NestJS (brique du composé)",
      "request": "launch",
      "type": "node",
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "hidden": true }
    }
  ],
  "compounds": [
    {
      // LE mode de travail : l'API et l'app ensemble, déjà câblées.
      "name": "Carlys",
      "configurations": [
        "API NestJS (brique du composé)",
        "Carlys — app (émulateur, brique du composé)"
      ]
    }
  ]
}
