#!/usr/bin/env bash
# carlysctl — l'orchestrateur de l'infrastructure Carlys.
#
#     carlysctl <commande> [environnement] [options]
#
# POURQUOI UN POINT D'ENTRÉE UNIQUE. Le serveur portait déjà quatre scripts
# (setup, deploy, promote, backup), chacun juste, chacun à connaître. Ce qui
# manquait n'était pas une cinquième commande : c'était UN endroit qui sache
# répondre à « est-ce que ça va ? » et « fais ce qu'il faut ». Les quatre
# scripts existants ne disparaissent pas — `carlysctl deploy` les appelle. On
# ne les recopie pas non plus : la logique de déploiement, de promotion et de
# sauvegarde reste chez eux, et ce fichier ne fait que router.
#
# CE FICHIER EST MINCE, ET DOIT LE RESTER. Il lit les arguments, vérifie
# l'environnement, appelle une fonction. Tout ce qui décide vit à côté :
#   _replicas.sh  exemplaires et amont Nginx
#   _metrics.sh   lecture de /metrics
#   _state.sh     mémoire entre deux passages
#   _scale.sh     décision de mise à l'échelle
#   _heal.sh      réparation, et son plafond
#   _update.sh    mise à jour autonome, et ce qui l'autorise
#   _status.sh    l'état des lieux
set -euo pipefail

# shellcheck source=scripts/server/_common.sh
. "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/_common.sh"

usage() {
  cat >&2 <<'FIN'
carlysctl — orchestrateur de l'infrastructure Carlys

REGARDER
  carlysctl status [staging|production]   état complet (défaut : les deux)
  carlysctl doctor                        vérifie les préalables de la machine
  carlysctl alert-test                    envoie une VRAIE alerte d'essai

AGIR À LA MAIN
  carlysctl deploy <env> <sha>            déploie un sha (appelle deploy.sh)
  carlysctl promote [sha]                 promeut en production (promote.sh)
  carlysctl backup                        sauvegarde (backup.sh)
  carlysctl admin-create <env> <email>    crée un compte du back-office
                                          (--role support|content-manager,
                                          --reset-password) — mot de passe
                                          saisi sans écho, jamais en argument
  carlysctl scale <env> <n>               fixe le nombre d'exemplaires d'API
  carlysctl heal <env>                    répare ce qui est tombé
  carlysctl env-sync <env> [--appliquer]  ajoute au .env les réglages qui lui
                                          manquent. N'écrase JAMAIS une ligne
                                          existante. --tout engendre en plus
                                          les secrets qui n'engagent aucun
                                          état extérieur ; ce qui doit être
                                          choisi par un humain reste refusé.
  carlysctl prune [--essai]               supprime les images Carlys inutiles,
                                          en gardant le sha déployé ET le
                                          précédent (cible du retour arrière)
  carlysctl update <env>                  applique la mise à jour, si activée

LAISSER FAIRE
  carlysctl autoscale <env> [--appliquer] décide la taille ; n'agit qu'avec
                                          --appliquer
  carlysctl supervise [env]               UN passage complet : réparation,
                                          mise à l'échelle, mise à jour.
                                          C'est ce que lance la minuterie
                                          systemd.

Toutes les commandes acceptent CARLYS_ROOT pour travailler contre une autre
racine que /srv/carlys — c'est ce qui permet de les répéter hors serveur.
FIN
  exit 2
}

# Combien de temps une commande TAPÉE À LA MAIN attend le verrou. Plus long
# qu'une passe de supervision (quelques secondes, jusqu'à une trentaine si
# elle relève des conteneurs), assez court pour ne pas donner l'impression
# d'un blocage. `deploy` et `promote` n'attendent pas — voir lock_env.
CARLYS_LOCK_WAIT="${CARLYS_LOCK_WAIT:-90}"

# ── Gardes communes ─────────────────────────────────────────────────────────
environnement_requis() {
  local nom
  nom="$(require_env_name "${1-}")"
  require_env_file "$nom" >/dev/null
  printf '%s' "$nom"
}

# Les deux environnements, dans l'ordre où on veut les voir : la recette
# d'abord, parce que c'est elle qu'on regarde avant de toucher la production.
tous_les_environnements() {
  local nom
  for nom in staging production; do
    [ -f "$(env_file "$nom")" ] && printf '%s\n' "$nom"
  done
}

# ── Commandes ───────────────────────────────────────────────────────────────
cmd_status() {
  local nom
  if [ -n "${1-}" ]; then
    status_env "$(environnement_requis "$1")"
  else
    while read -r nom; do status_env "$nom"; done < <(tous_les_environnements)
  fi
  status_machine
  printf '\n'
}

cmd_scale() {
  local env_name cible
  env_name="$(environnement_requis "${1-}")"
  cible="${2-}"
  case "$cible" in
    '' | *[!0-9]*) die "Nombre d'exemplaires attendu : carlysctl scale $env_name <n>" ;;
  esac
  require_commands docker
  require_compose_file
  lock_env "$env_name" "$CARLYS_LOCK_WAIT"
  scale_apply "$env_name" "$(env_file "$env_name")" "$cible"
}

cmd_autoscale() {
  local env_name file appliquer=non
  env_name="$(environnement_requis "${1-}")"
  [ "${2-}" = '--appliquer' ] && appliquer=oui
  file="$(env_file "$env_name")"
  require_commands docker curl
  require_compose_file
  autoscale_passage "$env_name" "$file" "$appliquer"
}

# Le corps partagé par `autoscale` et par `supervise`. Il MESURE, DÉCIDE, puis
# agit — ou se contente de dire ce qu'il ferait.
#
# L'échantillon est inscrit dans l'état À CHAQUE passage, y compris quand on
# n'applique pas : c'est lui qui permettra de calculer un débit au passage
# suivant. Ne l'écrire qu'en cas d'action rendrait le premier passage utile
# éternellement inutile.
autoscale_passage() {
  local env_name="$1" file="$2" appliquer="$3"
  local resume precedent taux debit latence actuel decision cible verdict raison votes

  resume="$(metrics_summary "$env_name" "$file")"
  precedent="$(state_get "$env_name" mesures '')"
  taux="$(metrics_rate "$precedent" "$resume")"
  debit="$(printf '%s' "$taux" | awk '{print $1}')"
  latence="$(printf '%s' "$taux" | awk '{print $2}')"
  state_set "$env_name" mesures "$resume"

  actuel="$(api_replica_ports "$env_name" "$file" | wc -l)"
  # Aucun exemplaire en vie : ce n'est pas un problème de taille, c'est une
  # panne. La mise à l'échelle n'a rien à dire ici — `heal` si.
  if [ "$actuel" -eq 0 ]; then
    warn "aucun exemplaire d'API en vie : mise à l'échelle sans objet (voir carlysctl heal $env_name)"
    return 0
  fi

  decision="$(scale_decide "$env_name" "$file" "$actuel" \
    "$(metrics_field "$resume" utilisateurs)" "$debit" "$latence")"
  cible="$(printf '%s' "$decision" | awk '{print $1}')"
  verdict="$(printf '%s' "$decision" | awk '{print $2}')"
  raison="$(printf '%s' "$decision" | awk '{print $3}')"
  votes="$(printf '%s' "$decision" | awk '{print $4}')"
  state_set "$env_name" votes_baisse "${votes:-0}"

  info "exemplaires $actuel → $cible ($verdict, $raison)"
  info "  utilisateurs=$(metrics_field "$resume" utilisateurs) débit=${debit:-?} req/s latence=${latence:-?} ms"

  case "$verdict" in
    monter | descendre)
      if [ "$appliquer" = oui ]; then
        lock_env "$env_name" "$CARLYS_LOCK_WAIT"
        scale_apply "$env_name" "$file" "$cible"
      else
        info "  (--appliquer absent : rien n'a été changé)"
      fi
      ;;
  esac
}

cmd_heal() {
  local env_name file
  env_name="$(environnement_requis "${1-}")"
  file="$(env_file "$env_name")"
  require_commands docker
  require_compose_file
  lock_env "$env_name" "$CARLYS_LOCK_WAIT"
  heal_run "$env_name" "$file"
}

cmd_prune() {
  local n
  require_commands docker
  step "Élagage des images Carlys"
  info "disque : $(disque_pourcent) % de $CARLYS_ROOT"
  n="$(prune_images "${1-}")"
  ok "$n image(s) $([ "${1-}" = '--essai' ] && printf 'seraient supprimées' || printf 'supprimée(s)')"
  info "disque après : $(disque_pourcent) %"
}

# `env-sync <env> [--appliquer] [--tout]` — ajoute au .env ce qui lui manque.
#
# ESSAI PAR DÉFAUT, comme `autoscale` : une commande qui écrit dans le fichier
# qui porte les secrets ne le fait pas parce qu'on a tapé son nom.
cmd_envsync() {
  local env_name file mode=essai portee=sur arg
  env_name="$(environnement_requis "${1-}")"
  shift || true
  for arg in "$@"; do
    case "$arg" in
      --appliquer) mode=ecrire ;;
      --tout) portee=tout ;;
      '') ;;
      *) die "Option inconnue : $arg" "Attendu : --appliquer, --tout" ;;
    esac
  done
  file="$(env_file "$env_name")"
  require_commands docker
  require_compose_file
  [ "$portee" = tout ] && require_commands openssl
  step "Complétion du .env de « $env_name »"
  # Le verrou : un déploiement qui lit le .env pendant qu'on y écrit verrait un
  # fichier tronqué. 90 s d'attente, comme heal et scale — la minuterie passe
  # toutes les deux minutes et une commande tapée à la main ne doit pas perdre
  # la course contre elle.
  lock_env "$env_name" "$CARLYS_LOCK_WAIT"
  envsync_appliquer "$env_name" "$file" "$mode" "$portee" || true
  unlock_env
}

# `alert-test` — prouver que le canal marche AVANT d'en avoir besoin.
#
# Un système d'alerte qu'on n'a jamais vu fonctionner n'est pas un système
# d'alerte : c'est une hypothèse. Cette commande envoie un vrai message par le
# vrai canal, et dit ce qui s'est passé.
cmd_alert_test() {
  local canal
  canal="$(alerte_canal)"
  step "Essai du canal d'alerte"
  info "configuration : $(alerte_config_file)"
  if [ "$canal" = aucun ]; then
    die "Aucun canal d'alerte configuré." \
      "Rien ne sortira de cette machine en cas de panne — ni sauvegarde ratée," \
      "ni déploiement échoué, ni disque plein." \
      "" \
      "Poser UNE des deux lignes dans $(alerte_config_file) :" \
      "  CARLYS_ALERT_WEBHOOK=https://ntfy.sh/<un-sujet-a-toi>   (aucun identifiant)" \
      "  CARLYS_ALERT_TO=toi@exemple.fr                          (+ CARLYS_ALERT_SMTP_URL)" \
      "" \
      "Modèle commenté : $CARLYS_REPO_DIR/infrastructure/server/env/alertes.env.example"
  fi
  info "canal        : $canal"
  if alerte_envoyer "[Carlys] essai du canal d'alerte" \
    "$(alerte_entete essai)
Ceci est un ESSAI, déclenché à la main par carlysctl alert-test.
Si tu lis ce message, une vraie alerte te parviendra aussi."; then
    ok "message envoyé — va le vérifier là où tu l'attends"
  else
    die "L'envoi a ÉCHOUÉ." \
      "Les avertissements ci-dessus disent pourquoi." \
      "Relire $(alerte_config_file)."
  fi
}

# `admin-create <env> <email> [--role <slug>] [--reset-password]` — un compte
# d'administration, par la seule voie qui existe : la commande embarquée dans
# l'image API. L'API n'a pas de route de création (un administrateur ne se crée
# pas depuis l'interface qu'il administre) et le seed ne s'exécute jamais en
# déploiement : sans ceci, la page de connexion du back-office est une porte
# sans clé.
#
# LE MOT DE PASSE NE PASSE NI EN ARGUMENT NI EN VARIABLE D'ENVIRONNEMENT : il
# est saisi sans écho, confirmé, et transmis au conteneur par l'entrée
# standard. Vide, la commande en engendre un et l'affiche une fois.
cmd_admin_create() {
  local env_name file email role=superadmin reset=non mdp='' mdp2='' hote
  env_name="$(environnement_requis "${1-}")"
  email="${2-}"
  [ -n "$email" ] || die "Adresse attendue." \
    "  carlysctl admin-create $env_name <email> [--role superadmin|support|content-manager] [--reset-password]"
  shift 2 || true
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --role) role="${2-}"; shift 2 ;;
      --reset-password) reset=oui; shift ;;
      *) die "Option inconnue : $1" "Attendu : --role <slug>, --reset-password" ;;
    esac
  done
  file="$(env_file "$env_name")"
  require_commands docker
  require_compose_file
  [ -n "$(deployed_current "$env_name")" ] || die "« $env_name » n'a jamais été déployé." \
    "La commande vit dans l'image API : déployer d'abord (carlysctl deploy $env_name <sha>)."

  # L'image déployée doit porter la commande — une image d'avant ce commit ne
  # l'a pas, et l'erreur de Node serait moins claire que celle-ci.
  if ! dc "$env_name" "$file" run --rm --no-deps -T --entrypoint test api \
      -f dist/cli/admin-bootstrap.js >/dev/null 2>&1; then
    die "L'image API déployée sur « $env_name » ne porte pas encore admin-bootstrap." \
      "Elle est antérieure à cette commande : déployer une version plus récente, puis relancer."
  fi

  step "Compte administrateur sur « $env_name »"
  info "adresse : $email"
  info "rôle    : $role"
  if [ -t 0 ]; then
    printf '   Mot de passe (vide = engendré et affiché une fois) : ' >&2
    read -rs mdp; printf '\n' >&2
    if [ -n "$mdp" ]; then
      printf '   Confirmer : ' >&2
      read -rs mdp2; printf '\n' >&2
      [ "$mdp" = "$mdp2" ] || die "Les deux saisies diffèrent — rien n'a été créé."
    fi
  else
    # Pas de terminal : le mot de passe est attendu sur NOTRE entrée standard,
    # et relayé tel quel.
    IFS= read -r mdp || true
  fi

  local -a opts=(--role "$role")
  [ "$reset" = oui ] && opts+=(--reset-password)
  printf '%s' "$mdp" | dc "$env_name" "$file" run --rm --no-deps -T api \
    node dist/cli/admin-bootstrap "$email" "${opts[@]}" || die "La création a échoué — le message ci-dessus dit pourquoi."

  hote="app"
  [ "$env_name" = staging ] && hote="app-staging"
  ok "connexion : https://${hote}.$(env_value DOMAIN "$file" '<domaine>')/login"
}

cmd_update() {
  local env_name file
  env_name="$(environnement_requis "${1-}")"
  file="$(env_file "$env_name")"
  require_compose_file
  # Pas de `lock_env` ici : deploy.sh et promote.sh prennent le verrou
  # eux-mêmes, et le prendre deux fois avec `flock` sur le même descripteur
  # bloquerait le script sur son propre verrou.
  update_run "$env_name" "$file"
}

# UN passage de supervision. L'ordre n'est pas négociable :
#
#   1. RÉPARER d'abord. Mesurer une pile à moitié tombée donne un débit et un
#      nombre d'utilisateurs qui ne veulent rien dire, et la mise à l'échelle
#      en tirerait la conclusion inverse de la bonne — moins de trafic reçu
#      parce que moins d'exemplaires pour le recevoir, donc « réduisons ».
#   2. METTRE À L'ÉCHELLE ensuite, sur une pile entière.
#   3. METTRE À JOUR en dernier. Un déploiement recrée les conteneurs :
#      le faire avant rendrait caduques les deux étapes précédentes.
cmd_supervise() {
  local env_name suivi=non
  if [ -n "${1-}" ]; then
    supervise_un "$(environnement_requis "$1")"
  else
    while read -r env_name; do supervise_un "$env_name"; done < <(tous_les_environnements)
  fi

  # LE CLONE, EN DERNIER — après toutes les passes, jamais avant. Un `git pull`
  # remplace les scripts que cette passe est en train d'exécuter ; c'est sans
  # danger (mesuré : l'inode change, le bash en cours garde le sien), mais il
  # n'y a aucune raison de le faire pendant qu'ils travaillent.
  #
  # Sous la MÊME autorisation que le déploiement automatique, et pour la même
  # raison : `CARLYS_AUTO_UPDATE=oui` veut dire « suivre main tout seul », et
  # les scripts font partie de main. Tant qu'aucun environnement ne l'a
  # demandé, le clone reste où l'exploitant l'a laissé.
  while read -r env_name; do
    [ "$(update_actif "$(env_file "$env_name")")" = oui ] && suivi=oui
  done < <(tous_les_environnements)
  [ "$suivi" = oui ] || return 0
  step "Dépôt cloné"
  repo_pull || true
}

supervise_un() {
  local env_name="$1" file
  file="$(env_file "$env_name")"
  step "Supervision de « $env_name »"

  # Le VERROU couvre la réparation et la mise à l'échelle : sans lui, une
  # passe de supervision pourrait lancer `docker compose up -d` en plein
  # milieu d'un déploiement tapé à la main, et les deux se marcheraient
  # dessus. Il est relâché AVANT la mise à jour, qui délègue à deploy.sh ou
  # promote.sh — deux scripts séparés qui prennent le verrou pour eux-mêmes.
  lock_env "$env_name"

  # EN PREMIER, parce que tout ce qui suit lit ce fichier. Un réglage arrivé
  # avec une nouvelle version du dépôt et absent du .env fait échouer la pile
  # entière ; l'ajouter ici évite que la mise à jour, plus bas, ne déploie
  # contre un fichier incomplet.
  #
  # Portée « sur » et pas « tout » : la supervision recopie les valeurs que
  # l'exemple porte en clair, elle n'ENGENDRE aucun secret sans qu'on le lui
  # demande. Les deux secrets engendrables produisent de toute façon un
  # symptôme bruyant que `status` et `doctor` nomment déjà, avec la commande
  # exacte — mieux vaut un humain averti qu'une valeur apparue toute seule
  # dans un fichier qu'il croit connaître.
  if [ "$(envsync_actif "$file")" = oui ]; then
    envsync_appliquer "$env_name" "$file" ecrire sur || true
  fi

  # Chaque étape est isolée : un `heal` qui échoue (plafond atteint) ne doit
  # pas empêcher la mise à jour de tourner, et inversement. Le code de retour
  # global reste 0 — c'est une minuterie qui appelle, et un échec systemd
  # répété ne dirait rien de plus que les avertissements déjà journalisés.
  heal_run "$env_name" "$file" || true
  autoscale_passage "$env_name" "$file" oui || true
  # Le disque est la panne qui tue un serveur dédié plus souvent que la
  # charge. Élague à CHAQUE passe (seuls les deux shas du filet sont gardés) ;
  # le seuil CARLYS_DISK_HIGH_PERCENT n'est plus que le niveau d'alerte.
  prune_si_necessaire "$file" || true

  unlock_env
  update_run "$env_name" "$file" || true
}

# Vérifie que la machine a de quoi faire tourner tout ça. Volontairement
# bavard sur ce qui MANQUE, muet sur ce qui va.
cmd_doctor() {
  local manque=0 outil env_name file
  step "Outils"
  for outil in docker curl git flock awk nginx; do
    if command -v "$outil" >/dev/null 2>&1; then
      ok "$outil"
    else
      warn "$outil ABSENT"; manque=1
    fi
  done
  if docker compose version >/dev/null 2>&1; then ok 'plugin docker compose'
  else warn 'plugin docker compose ABSENT'; manque=1; fi

  # Le binaire présent ne dit RIEN du démon. `doctor` annonçait « tout est en
  # place » et rendait 0 avec dockerd arrêté — c'est-à-dire au moment précis où
  # plus rien ne peut tourner.
  if timeout 10 docker info >/dev/null 2>&1; then
    ok 'démon Docker joignable'
  else
    warn 'démon Docker INJOIGNABLE — rien ne peut démarrer'
    warn '  systemctl status docker ; journalctl -u docker -n 50'
    manque=1
  fi

  # LES DEUX SERVICES SANS LESQUELS TOUT LE RESTE EST DÉCORATIF. nginx couché,
  # et l'amont soigneusement engendré ne sert plus un octet ; la minuterie
  # désarmée, et « auto-géré » redevient un mot — plus de réparation, plus de
  # mise à l'échelle, plus de mise à jour, sans un seul message nulle part.
  # `doctor` disait « tout est en place » dans les deux cas.
  step "Services"
  if pgrep -x nginx >/dev/null 2>&1; then
    ok 'nginx en marche'
  else
    warn 'nginx NE TOURNE PAS — aucun trafic ne passe, quel que soit l'"'"'état de la pile'
    warn '  systemctl status nginx ; nginx -t'
    manque=1
  fi
  if systemctl is-active --quiet carlys-supervision.timer 2>/dev/null; then
    ok 'minuterie de supervision armée'
  else
    warn 'minuterie carlys-supervision.timer NON armée — RIEN ne tourne tout seul'
    warn '  ni réparation, ni mise à l'"'"'échelle, ni mise à jour.'
    warn '  systemctl enable --now carlys-supervision.timer'
    manque=1
  fi

  step "Fichiers"
  if [ -f "$CARLYS_COMPOSE_FILE" ]; then
    ok "compose : $CARLYS_COMPOSE_FILE"
  else
    warn "compose introuvable : $CARLYS_COMPOSE_FILE"; manque=1
  fi
  if [ -f "$(ghcr_token_file)" ]; then
    ok "jeton de registre : $(ghcr_token_file)"
  else
    warn "jeton de registre absent : $(ghcr_token_file)"; manque=1
  fi

  # UN SYSTÈME D'ALERTE ÉTEINT EN SILENCE est le défaut que _alert.sh répare :
  # `doctor` doit donc le dire fort, et pas seulement quand il est cassé.
  step "Alertes"
  case "$(alerte_canal)" in
    aucun)
      warn "AUCUN canal — rien ne sortira de cette machine en cas de panne"
      warn "  ni sauvegarde ratée, ni déploiement échoué, ni disque plein."
      warn "  Poser une ligne dans $(alerte_config_file) — modèle :"
      warn "  $CARLYS_REPO_DIR/infrastructure/server/env/alertes.env.example"
      manque=1
      ;;
    *) ok "canal : $(alerte_canal) — l'éprouver : carlysctl alert-test" ;;
  esac

  step "Environnements"
  while read -r env_name; do
    file="$(env_file "$env_name")"
    ok "$env_name : $file"
    if [ ! -f "$(nginx_upstream_file "$env_name")" ]; then
      warn "  amont Nginx absent : $(nginx_upstream_file "$env_name")"
      warn "  nginx refusera toute la configuration tant qu'il manque."
      manque=1
    fi
    # Le contenu du .env : demandé à Compose, jamais recopié ici. Voir
    # _envcheck.sh — une liste de variables obligatoires écrite à la main
    # périme au premier ajout dans compose.yml, sans que rien ne le dise.
    envcheck_env "$env_name" "$file" || manque=1
    # La branche des IMAGES contre celle des SCRIPTS. Voir _repo.sh : c'est
    # cette divergence-là qui a fait reculer une recette de 14 commits.
    repo_avertir_branches "$file" || manque=1
  done < <(tous_les_environnements)

  printf '\n'
  if [ "$manque" -eq 0 ]; then
    ok 'tout est en place'
  else
    warn 'il manque des choses — voir ci-dessus'
  fi
  return "$manque"
}

# ── Aiguillage ──────────────────────────────────────────────────────────────
COMMANDE="${1-}"
if [ "$#" -ge 1 ]; then shift; fi
case "$COMMANDE" in
  status)    cmd_status "${1-}" ;;
  scale)     cmd_scale "${1-}" "${2-}" ;;
  autoscale) cmd_autoscale "${1-}" "${2-}" ;;
  heal)      cmd_heal "${1-}" ;;
  env-sync)  cmd_envsync "$@" ;;
  alert-test) cmd_alert_test ;;
  admin-create) cmd_admin_create "$@" ;;
