# ══════════════════════════════════════════════════════════════════════════
# Carlys — variables d'environnement de développement (docker-compose.yml).
# TOUTES LES VALEURS SONT FACTICES. Copier vers .env puis adapter.
# Ne JAMAIS commiter un vrai secret — voir SECURITY.md.
# ══════════════════════════════════════════════════════════════════════════

# ── PostgreSQL (service docker `postgres`) ─────────────────────────────────
POSTGRES_USER=carlys
POSTGRES_PASSWORD=carlys_dev_password
POSTGRES_DB=carlys_dev

# ── MinIO (stockage compatible S3 en local) ───────────────────────────────
MINIO_ROOT_USER=carlys-dev
MINIO_ROOT_PASSWORD=carlys-dev-secret
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_MEDIA=carlys-media

# ── SMTP de développement (Mailpit — interface sur http://localhost:8025) ─
SMTP_HOST=localhost
SMTP_PORT=1025

# Chaque application possède aussi son propre fichier :
#   apps/api/.env        (copier depuis apps/api/.env.example)
#   apps/admin/.env.local (copier depuis apps/admin/.env.example)
