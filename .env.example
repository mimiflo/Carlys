# ══════════════════════════════════════════════════════════════════════════
# Carlys — variables d'environnement de développement (docker-compose.yml).
# TOUTES LES VALEURS SONT FACTICES. Copier vers .env puis adapter.
# Ne JAMAIS commiter un vrai secret — voir SECURITY.md.
#
# CE FICHIER NE CONTIENT QUE CE QUE docker-compose.yml INTERPOLE VRAIMENT.
# Il a longtemps porté S3_ENDPOINT, S3_BUCKET_MEDIA, SMTP_HOST et SMTP_PORT :
# compose code ces quatre-là EN DUR dans le service `api` (mailpit:1025,
# http://minio:9000), donc les régler ici n'avait aucun effet — et
# S3_BUCKET_MEDIA n'existait nulle part ailleurs dans le dépôt. Inversement,
# les deux que compose lit réellement, JWT_ACCESS_SECRET et
# S3_PUBLIC_BASE_URL, n'y figuraient pas.
#
# La liste se vérifie, elle ne se croit pas :
#   grep -oE '\$\{[A-Z_][A-Z_0-9]*' docker-compose.yml | tr -d '${' | sort -u
# ══════════════════════════════════════════════════════════════════════════

# ── PostgreSQL (service docker `postgres`) ─────────────────────────────────
POSTGRES_USER=carlys
POSTGRES_PASSWORD=carlys_dev_password
POSTGRES_DB=carlys_dev

# ── MinIO (stockage compatible S3 en local) ───────────────────────────────
MINIO_ROOT_USER=carlys-dev
MINIO_ROOT_PASSWORD=carlys-dev-secret

# Adresse publique des médias, telle que le CLIENT la verra. `localhost` ne
# vaut que pour un navigateur sur cette machine : pour tester depuis un
# téléphone du même réseau, mettre l'IP du poste (http://192.168.x.y:9000/…),
# sans quoi les images du catalogue ne se chargent pas sur l'appareil.
# Le bucket, lui, est fixé par minio-init dans docker-compose.yml.
S3_PUBLIC_BASE_URL=http://localhost:9000/carlys-media

# ── API en conteneur (profil `api` de docker-compose.yml) ─────────────────
# Signature des jetons d'accès. La valeur par défaut de compose est publiée
# dans ce dépôt : elle ne vaut que pour une pile locale jetable. Sur toute
# machine joignable par quelqu'un d'autre, en poser une neuve —
#   openssl rand -base64 48
JWT_ACCESS_SECRET=secret-jwt-de-developpement-a-remplacer-absolument

# Chaque application possède aussi son propre fichier :
#   apps/api/.env        (copier depuis apps/api/.env.example) — c'est LUI qui
#                        porte SMTP_*, S3_* et le reste du schéma Zod
#   apps/admin/.env.local (copier depuis apps/admin/.env.example)
